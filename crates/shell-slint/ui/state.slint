    label: string,
    x: float,
    y: float,
    r: float,
    fill: float,
    fill-text: string,
    mark: MarkState,
    overlay: bool,
}

export struct ChipVM {
    label: string,
    key: string,
    suggested: bool,
    selected: bool,
}

export struct ContactTile {
    image: image,
    // index of the tile (the shell maps it back to the item)
    id: int,
    serial: string,
    current: bool,
    label: string,
}

export struct Candidate {
    rank: int,
    name: string,
    name-ar: string,
    student-id: string,
    national-id: string,
    meta: string,
    posterior: string,
    channels: [KV],
    suggested: bool,
    selected: bool,
}

export global ReviewVM {
    in property <[LaneChip]> lanes;
    in property <int> resolved;
    in property <int> total;
    in property <[QueueEntry]> queue;
    in property <length> selected-y;
    in property <bool> has-item;
    // false for an item with no scan behind it (an exam-level notice): no paper, view chips or
    // rescan action
    in property <bool> has-scan: true;
    // item: 0 mark, 1 blind verify, 2 identity, 3 notice
    in property <int> kind;
    in property <string> code;
    in property <string> code-title;
    in property <string> sub-reason;
    in property <Severity> severity;
    in property <string> caption;
    in property <string> question-label;
    in property <image> crop;
    in property <image> original;
    in property <bool> has-original;
    in property <float> crop-w;
    in property <float> crop-h;
    in property <[BubbleVM]> bubbles;
    in property <[BubbleVM]> fill-bars;
    in property <float> threshold;
    in property <float> band-lo;
    in property <float> band-hi;
    in property <bool> has-suggestion;
    in property <string> suggestion-letter;
    in property <string> suggestion-word;
    in property <string> suggestion-source;
    in property <string> suggestion-detail;
    in property <string> suggestion-tag;
    in property <[ChipVM]> options;
    in property <[ChipVM]> specials;
    // the decision overrides the suggestion: a reason code is required (§13.4)
    in property <bool> reason-needed;
    in property <[ChipVM]> reasons;
    // the chosen reason needs a note saying why (OTHER, SOLO_SELF_APPROVAL, §14.4)
    in property <bool> note-required;
    // identity items: a student number typed by the reviewer (pending until Accept)
    in-out property <string> student-entry;
    in property <string> typed-student;
    callback use-student(string);
    in property <[Candidate]> candidates;
    in property <[ContactTile]> contact;
    in property <string> contact-caption;
    in property <string> read-id;
    in property <string> boxes-read;
    in property <string> hypothesis;
    in property <[string]> neighbours;
    in property <string> notice-headline;
    in property <[KV]> notice-lines;
    in property <string> notice-consequence;
    in property <[float]> other-fills;
    in property <string> other-caption;
    in property <string> summary;
    in property <string> accept-label;
    in property <bool> accept-enabled;
    in property <string> accept-hint;
    in property <string> group-label;
    in property <bool> group-enabled;
    in property <string> group-reason;
    in property <bool> overlay;
    in property <bool> show-all;
    in property <bool> registered;
    in property <int> zoom;
    in-out property <string> note;
    in property <string> median;
    // "Threshold 0.45 · hysteresis band 0.35–0.55"
    in property <string> threshold-text;
    in property <string> audit-head;
    in property <bool> two-person;
    in property <string> help-text;
    in property <bool> help-open;
    // an empty queue: what it means ("Lane clear") and why (the exam is being graded, …)
    in property <string> empty-title;
    in property <string> empty-text;
    // incremented by Rust on "/" or Ctrl+F: the review screen focuses the roster search
    in property <int> search-request;
    callback select-lane(int);
    // a queue row (by its handle) and a contact-sheet tile (by its index)
    callback select-item(int);
    callback select-contact(int);
    callback toggle-group(string);
    callback choose-option(int);
    callback choose-special(int);
    callback choose-reason(int);
    callback choose-candidate(int);
    callback accept();
    callback apply-group();
    callback defer();
    callback escalate();
    callback rescan();
    callback undo();
    callback toggle-overlay();
    callback toggle-show-all();
    callback toggle-registered();
    callback zoom-by(int);
    callback toggle-help();
    callback search(string);
    callback key(string, bool, bool, bool) -> bool;
}

// ------------------------------------------------------------------------------- results

export struct GradeBar {
    letter: string,
    letter-ar: string,
    band: string,
    count: int,
    frac: float,
    fail: bool,
}

export struct StatusBarVM {
    code: string,
    label: string,
    label-ar: string,
    count: int,
}

export struct ItemRow {
    q: string,
    p: string,
    r: string,
    r-ci: string,
    r-negative: bool,
    steps: int,
    band: string,
    shares: [float],
    keyed: int,
    flag: string,
    flag-tone: Tone,
    has-flag: bool,
    // flag stability (§12.2): "98 %" high, "31 % · proposed" low, "computing…", "" none
    stability: string,
    stability-tone: Tone,
    // 0 none, 1 high, 2 low (proposed), 3 computing
    stability-kind: int,
    selected: bool,
    label: string,
}

export struct CheckRow {
    tone: Tone,
    text: string,
    action: string,
}

export global ResultsVM {
    in property <bool> available;
    // why there are no results yet (e.g. a key from key sheets waits for its confirmation)
    in property <string> empty-title;
    in property <string> empty-text;
    in property <bool> empty-to-setup;
    in property <string> key-label;
    in property <string> students;
    in property <string> students-caption;
    in property <string> mean;
    in property <string> mean-caption;
    in property <string> pass-rate;
    in property <string> pass-caption;
    in property <string> alpha;
    in property <string> alpha-caption;
    in property <string> sem;
    in property <string> sem-caption;
    in property <string> open-errors;
    in property <string> open-caption;
    in property <[GradeBar]> grades;
    in property <[StatusBarVM]> statuses;
    in property <string> scale-label;
    in property <[float]> histogram;
    in property <[int]> histogram-counts;
    in property <float> pass-mark: 60;
    in property <float> mean-pct;
    in property <float> sem-pct;
    in property <string> histogram-caption;
    in property <[ItemRow]> items;
    in property <[string]> option-labels;
    in property <[CheckRow]> readiness;
    in property <bool> release-blocked;
    in property <string> release-reason;
    // exports (§16.3): every file next to the project, and the Blackboard grade-center upload
    in property <bool> can-export;
    in property <bool> blackboard-ready;
    in property <string> blackboard-note;
    in-out property <bool> export-open;
    // the release confirmation (§13.4): opened by "Release results…", confirmed by Release
    in-out property <bool> release-open;
    in property <string> release-note;
    in-out property <string> blackboard-column;
    callback export-all();
    callback export-blackboard(string);
    in-out property <bool> show-key;
    in-out property <bool> grade-table;
    // the item row selected, by its question label ("Q03", "B-Q03"; "" none)
    in property <string> selected-q;
    callback select-item(string);
    callback release();
    callback what-if();
    callback check-action(int);
}

// ------------------------------------------------------------------------------- outcomes

export struct CloRow {
    code: string,
    domain: string,
    title: string,
    title-ar: string,
    target: float,
    average: float,
    average-text: string,
    average-lo: float,
    average-hi: float,
    proportion: float,
    proportion-text: string,
    proportion-lo: float,
    proportion-hi: float,
    // 95 % CI of each statistic, printed on its own bar's line
    average-ci-text: string,
    proportion-ci-text: string,
    // which statistic the policy decides on: 0 average μ, 1 threshold-proportion π, -1 neither
    deciding: int,
    n: string,
    verdict: string,
    verdict-tone: Tone,
    badge: bool,
    note: string,
    label: string,
}

export struct B1Row {
    header: bool,
    domain-title: string,
    domain-title-ar: string,
    number: string,
    clo: string,
    plo: string,
    methods: string,
    targeted: string,
    actual: string,
    comment: string,
    comment-tone: Tone,
    // text lines the tallest cell wraps to (1–4); sets the row height
    lines: int,
}

export global OutcomesVM {
    in property <bool> available;
    // why there is no attainment to show, and whether Setup is where to go (a CLO file)
    in property <string> empty-title;
    in property <string> empty-text;
    in property <bool> empty-to-setup;
    in property <string> policy;
    in property <string> policy-version;
    in property <string> method-label;
    in property <float> target: 0.7;
    in property <[CloRow]> clos;
    in property <[B1Row]> b1;
    in property <string> classification;
    in property <string> attained-summary;
    // TP-154 footnote: the deciding method, τ and T (§11.4, actual_level_display = both)
    in property <string> footnote;
    callback export-tp154();
}
