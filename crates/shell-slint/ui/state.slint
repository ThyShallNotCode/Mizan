// View-model globals of the shell. Rust (src/bind.rs) fills them from a `Backend` and handles
// every callback; the .slint files only lay the data out (spec §4.7: shells contain no logic).

import { Tone, Severity, MarkState } from "theme.slint";

export enum Page { exams, setup, scan, review, results, outcomes, settings }

// ------------------------------------------------------------------------------- app chrome

export global App {
    in-out property <Page> page: Page.exams;
    // exam context for breadcrumbs
    in property <string> course: "CS 211 Data Structures";
    in property <string> assessment: "Midterm 1";
    in property <string> term: "1448 H, 1st term";
    in property <string> term-gregorian: "Fall 2026";
    in property <int> review-open;
    in property <string> user-name;
    in property <string> user-role;
    in property <string> user-initials;
    in property <string> engine: "omr 0.1.0";
    in property <string> workspace;
    // invented demo data (`--demo`): a banner on every screen says so
    in property <bool> demo;
    // where the data comes from (Settings · About)
    in property <string> data-note;
    // last command result, e.g. "Recorded Q17: B" or a validation error
    in property <string> message;
    in property <Tone> message-tone: Tone.neutral;
    // settings
    in-out property <bool> single-key: true;
    in-out property <bool> show-all-default: false;
    callback navigate(Page);
    callback set-dark(bool);
    callback set-reduce-motion(bool);
    callback set-single-key(bool);
    // a command the shell forwards but the demo backend does not model (e.g. "New exam")
    callback request(string);
    // global keys (Ctrl+1..6, Ctrl+0/Ctrl+comma, Escape); returns true when handled
    callback key(string, bool, bool, bool) -> bool;
}

// ------------------------------------------------------------------------------- exams

export struct ExamRow {
    id: string,
    code: string,
    title: string,
    title-ar: string,
    assessment: string,
    date: string,
    date-hijri: string,
    term: string,
    forms: [string],
    scanned: string,
    expected: string,
    progress: float,
    progress-tone: Tone,
    info: int,
    warn: int,
    error: int,
    blocker: int,
    status: string,
    status-tone: Tone,
    // accessible row label
    label: string,
}

export struct FilterChip {
    label: string,
    count: int,
}

export struct ExamDrawer {
    code: string,
    title: string,
    title-ar: string,
    assessment: string,
    status: string,
    status-tone: Tone,
    callout-title: string,
    callout-text: string,
    callout-tone: Tone,
    review-label: string,
    can-review: bool,
    key-status: string,
    mapped: int,
    mapped-word: string,
    total: int,
    roster: string,
    sections: string,
    last-scan: string,
    batch-id: string,
    term: string,
    term-ar: string,
}

export global ExamsVM {
    in property <[ExamRow]> rows;
    in property <[FilterChip]> filters;
    in property <int> filter;
    in property <int> selected: -1;
    in property <bool> drawer-open;
    in property <ExamDrawer> drawer;
    in property <string> sheets-week;
    in property <string> sheets-today;
    in property <string> open-exceptions;
    in property <string> open-errors;
    in property <string> median-review;
    in property <string> median-caption;
    in property <string> throughput;
    in property <string> term-label;
    // incremented by Rust on Ctrl+K: the dashboard focuses its search field
    in property <int> search-request;
    // select row n and open the drawer (click, Enter)
    callback select(int);
    // move the selection by n rows, keeping the drawer as it is (↑ / ↓)
    callback move(int);
    callback set-filter(int);
    // open the selected exam on a page
    callback open(Page);
    callback close-drawer();
    // the New-exam form (CR-04): what the instructor types; Rust validates and grades it
    in-out property <bool> new-open;
    in property <bool> can-create;
    in property <string> new-note;
    in-out property <string> new-title;
    in-out property <string> new-course;
    in-out property <string> new-scans;
    in-out property <string> new-sheet: "iau-ccsit-v1";
    in-out property <string> new-questions;
    in-out property <string> new-options;
    in-out property <string> new-forms;
    in-out property <string> new-key;
    in-out property <string> new-roster;
    in-out property <string> new-clo;
    callback create-exam();
}

// ------------------------------------------------------------------------------- setup

export struct MapCell {
    text: string,
    weight: float,
    mapped: bool,
    has-note: bool,
    selected: bool,
    label: string,
}

export struct MapRow {
    q: int,
    label: string,
    keys: [string],
    points: string,
    cells: [MapCell],
    sum: string,
    sum-ok: bool,
    status: string,
    status-tone: Tone,
}

export struct CloHead {
    code: string,
    domain: string,
    title: string,
    title-ar: string,
    plo: string,
    share: float,
    share-text: string,
    items: int,
}

export struct LintRow {
    code: string,
    severity: Severity,
    message: string,
}

export struct KV {
    label: string,
    value: string,
    tone: Tone,
}

export global SetupVM {
    in property <bool> available;
    in property <bool> has-roster: true;
    in property <[KV]> template;
    in property <string> template-id;
    in property <string> template-kind;
    in property <[string]> versions;
    in property <[string]> options;
    in property <string> key-status;
    in property <bool> key-published;
    in property <string> mapping-mode;
    in property <[CloHead]> clos;
    in property <[MapRow]> rows;
    in property <[LintRow]> lints;
    in property <int> sel-row;
    in property <int> sel-col;
    in property <string> sel-title;
    in property <string> sel-clo;
    in property <string> sel-weight;
    in property <string> sel-note;
    in property <string> error;
    // replace the whole key from a key file (CSV, TSV, any layout `omr grade` reads)
    in-out property <bool> key-open;
    in-out property <string> key-path;
    in property <bool> can-replace-key;
    callback replace-key(string);
    callback cycle-key(int, int);
    callback set-key(int, int, string);
    callback set-weight(int, int, string);
    callback set-note(int, int, string);
    callback select-cell(int, int);
}

// ------------------------------------------------------------------------------- scan

export struct Thumb {
    serial: string,
    // 0 auto, 1 review, 2 rejected, 3 reading, 4 queued
    state: int,
    code: string,
    severity: Severity,
    variant: int,
    label: string,
}

export struct CodeBar {
    code: string,
    title: string,
    severity: Severity,
    count: int,
    frac: float,
}

export global ScanVM {
    in property <bool> available;
    in property <string> batch-label;
    in property <string> source;
    in property <string> device;
    in property <bool> running;
    in property <float> pps;
    in property <float> pps-max: 120;
    in property <float> pps-floor: 40;
    in property <string> pps-text;
    in property <string> pages-value;
    in property <string> pages-caption;
    in property <string> auto-value;
    in property <string> auto-caption;
    in property <string> first-value;
    in property <string> first-caption;
    in property <string> remaining-value;
    in property <string> remaining-caption;
    in property <float> done-frac;
    in property <float> flight-frac;
    in property <[KV]> stages;
    // the worst codes (at most 7 rows fit the column at 1280 × 800); the rest are counted
    in property <[CodeBar]> codes;
    in property <int> codes-more;
    in property <[Thumb]> thumbs;
    in property <[image]> thumb-images;
    in property <string> auto-count;
    in property <string> review-count;
    in property <string> rejected-count;
    in property <[KV]> recon;
    in property <string> recon-code;
    in property <Severity> recon-severity;
    in property <[string]> activity;
    in property <string> engine;
    in property <int> workers;
    in property <int> review-open;
    // a capture agent runs the batch (Pause and Stop); file imports cannot be paused
    in property <bool> pausable: true;
    // adding a later batch (another section, another day) to this exam, §8.1
    in property <bool> can-add;
    in property <string> add-note;
    in-out property <bool> add-open;
    in-out property <string> add-path;
    callback add-scans(string);
    callback toggle-pause();
    callback open-review();
    callback open-code(string);
    // a thumbnail: its serial and worst open code ("" when none)
    callback open-sheet(string, string);
}

// ------------------------------------------------------------------------------- review

export struct LaneChip {
    label: string,
    count: int,
    selected: bool,
}

export struct QueueEntry {
    header: bool,
    code: string,
    title: string,
    severity: Severity,
    count: int,
    expanded: bool,
    // row handle: index into the shell's item list (never a raw item id)
    id: int,
    label: string,
    detail: string,
    serial: string,
    fills: [float],
    selected: bool,
    blind: bool,
    deferred: bool,
    a11y: string,
}

export struct BubbleVM {
    label: string,
    x: float,
    y: float,
    r: float,
    fill: float,
    fill-text: string,
    mark: MarkState,
    overlay: bool,
}

export struct ChipVM {
    label: string,
    key: string,
    suggested: bool,
    selected: bool,
}

export struct ContactTile {
    image: image,
    // index of the tile (the shell maps it back to the item)
    id: int,
    serial: string,
    current: bool,
    label: string,
}

export struct Candidate {
    rank: int,
    name: string,
    name-ar: string,
    student-id: string,
    national-id: string,
    meta: string,
    posterior: string,
    channels: [KV],
    suggested: bool,
    selected: bool,
}

export global ReviewVM {
    in property <[LaneChip]> lanes;
    in property <int> resolved;
    in property <int> total;
    in property <[QueueEntry]> queue;
    in property <length> selected-y;
    in property <bool> has-item;
    // item: 0 mark, 1 blind verify, 2 identity, 3 notice
    in property <int> kind;
    in property <string> code;
    in property <string> code-title;
    in property <string> sub-reason;
    in property <Severity> severity;
    in property <string> caption;
    in property <string> question-label;
    in property <image> crop;
    in property <image> original;
    in property <bool> has-original;
    in property <float> crop-w: 640;
    in property <float> crop-h: 168;
    in property <[BubbleVM]> bubbles;
    in property <[BubbleVM]> fill-bars;
    in property <float> threshold: 0.45;
    in property <float> band-lo: 0.35;
    in property <float> band-hi: 0.55;
    in property <bool> has-suggestion;
    in property <string> suggestion-letter;
    in property <string> suggestion-word;
    in property <string> suggestion-source;
    in property <string> suggestion-detail;
    in property <string> suggestion-tag;
    in property <[ChipVM]> options;
    in property <[ChipVM]> specials;
    // the decision overrides the suggestion: a reason code is required (§13.4)
    in property <bool> reason-needed;
    in property <[ChipVM]> reasons;
    // the chosen reason needs a note saying why (OTHER, SOLO_SELF_APPROVAL, §14.4)
    in property <bool> note-required;
    // identity items: a student number typed by the reviewer (pending until Accept)
    in-out property <string> student-entry;
    in property <string> typed-student;
    callback use-student(string);
    in property <[Candidate]> candidates;
    in property <[ContactTile]> contact;
    in property <string> contact-caption;
    in property <string> read-id;
    in property <string> boxes-read;
    in property <string> hypothesis;
    in property <[string]> neighbours;
    in property <string> notice-headline;
    in property <[KV]> notice-lines;
    in property <string> notice-consequence;
    in property <[float]> other-fills;
    in property <string> other-caption;
    in property <string> summary;
    in property <string> accept-label;
    in property <bool> accept-enabled;
    in property <string> accept-hint;
    in property <string> group-label;
    in property <bool> group-enabled;
    in property <string> group-reason;
    in property <bool> overlay: true;
    in property <bool> show-all;
    in property <bool> registered: true;
    in property <int> zoom: 3;
    in-out property <string> note;
    in property <string> median;
    // "Threshold 0.45 · hysteresis band 0.35–0.55"
    in property <string> threshold-text;
    in property <string> audit-head;
    in property <bool> two-person;
    in property <string> help-text;
    in property <bool> help-open;
    in property <string> empty-text;
    // incremented by Rust on "/" or Ctrl+F: the review screen focuses the roster search
    in property <int> search-request;
    callback select-lane(int);
    // a queue row (by its handle) and a contact-sheet tile (by its index)
    callback select-item(int);
    callback select-contact(int);
    callback toggle-group(string);
    callback choose-option(int);
    callback choose-special(int);
    callback choose-reason(int);
    callback choose-candidate(int);
    callback accept();
    callback apply-group();
    callback defer();
    callback escalate();
    callback rescan();
    callback undo();
    callback toggle-overlay();
    callback toggle-show-all();
    callback toggle-registered();
    callback zoom-by(int);
    callback toggle-help();
    callback search(string);
    callback key(string, bool, bool, bool) -> bool;
}

