    p: string,
    r: string,
    r-ci: string,
    r-negative: bool,
    steps: int,
    band: string,
    shares: [float],
    keyed: int,
    flag: string,
    flag-tone: Tone,
    has-flag: bool,
    selected: bool,
    label: string,
}

export struct CheckRow {
    tone: Tone,
    text: string,
    action: string,
}

export global ResultsVM {
    in property <bool> available;
    in property <string> key-label;
    in property <string> students;
    in property <string> students-caption;
    in property <string> mean;
    in property <string> mean-caption;
    in property <string> pass-rate;
    in property <string> pass-caption;
    in property <string> alpha;
    in property <string> alpha-caption;
    in property <string> sem;
    in property <string> sem-caption;
    in property <string> open-errors;
    in property <string> open-caption;
    in property <[GradeBar]> grades;
    in property <[StatusBarVM]> statuses;
    in property <string> scale-label;
    in property <[float]> histogram;
    in property <[int]> histogram-counts;
    in property <float> pass-mark: 60;
    in property <float> mean-pct;
    in property <float> sem-pct;
    in property <string> histogram-caption;
    in property <[ItemRow]> items;
    in property <[string]> option-labels;
    in property <[CheckRow]> readiness;
    in property <bool> release-blocked;
    in property <string> release-reason;
    // exports (§16.3): every file next to the project, and the Blackboard grade-center upload
    in property <bool> can-export;
    in property <bool> blackboard-ready;
    in property <string> blackboard-note;
    in-out property <bool> export-open;
    // the release confirmation (§13.4): opened by "Release results…", confirmed by Release
    in-out property <bool> release-open;
    in property <string> release-note;
    in-out property <string> blackboard-column;
    callback export-all();
    callback export-blackboard(string);
    in-out property <bool> show-key;
    in-out property <bool> grade-table;
    in property <int> selected-item: -1;
    callback select-item(int);
    callback release();
    callback what-if();
    callback check-action(int);
}

// ------------------------------------------------------------------------------- outcomes

export struct CloRow {
    code: string,
    domain: string,
    title: string,
    title-ar: string,
    target: float,
    average: float,
    average-text: string,
    average-lo: float,
    average-hi: float,
    proportion: float,
    proportion-text: string,
    proportion-lo: float,
    proportion-hi: float,
    // 95 % CI of each statistic, printed on its own bar's line
    average-ci-text: string,
    proportion-ci-text: string,
    // which statistic the policy decides on: 0 average μ, 1 threshold-proportion π, -1 neither
    deciding: int,
    n: string,
    verdict: string,
    verdict-tone: Tone,
    badge: bool,
    note: string,
    label: string,
}

export struct B1Row {
    header: bool,
    domain-title: string,
    domain-title-ar: string,
    number: string,
    clo: string,
    plo: string,
    methods: string,
    targeted: string,
    actual: string,
    comment: string,
    comment-tone: Tone,
    // text lines the tallest cell wraps to (1–4); sets the row height
    lines: int,
}

export global OutcomesVM {
    in property <bool> available;
    in property <string> policy;
    in property <string> policy-version;
    in property <string> method-label;
    in property <float> target: 0.7;
    in property <[CloRow]> clos;
    in property <[B1Row]> b1;
    in property <string> classification;
    in property <string> attained-summary;
    // TP-154 footnote: the deciding method, τ and T (§11.4, actual_level_display = both)
    in property <string> footnote;
    callback export-tp154();
}
