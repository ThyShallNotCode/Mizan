// View-model globals of the shell. Rust (src/bind.rs) fills them from a `Backend` and handles
// every callback; the .slint files only lay the data out (spec §4.7: shells contain no logic).

import { Tone, Severity, MarkState } from "theme.slint";

export enum Page { exams, setup, scan, review, results, outcomes, settings }

// ------------------------------------------------------------------------------- app chrome

export global App {
    in-out property <Page> page: Page.exams;
    // an exam is open (the dashboard lists the current exam): the screens that show one exam
    // say so, and lead to the Exams screen, when it is false
    in property <bool> has-exam;
    // exam context for breadcrumbs ("" with no exam open: nothing here is ever a placeholder)
    in property <string> course;
    in property <string> assessment;
    in property <string> term;
    in property <string> term-gregorian;
    in property <int> review-open;
    in property <string> user-name;
    in property <string> user-role;
    in property <string> user-initials;
    in property <string> engine;
    in property <string> workspace;
    // invented demo data (`--demo`): a banner on every screen says so
    in property <bool> demo;
    // where the data comes from (Settings · About)
    in property <string> data-note;
    // last command result, e.g. "Recorded Q17: B" or a validation error
    in property <string> message;
    in property <Tone> message-tone: Tone.neutral;
    // the window has file dialogs (the desktop app; not headless tests or screenshots): path
    // fields offer Browse… beside the typed path
    in property <bool> can-browse;
    // the window can show a folder in the system's file manager
    in property <bool> can-reveal;
    // the file manager's verb on this system ("Show in Explorer" on Windows)
    in property <string> reveal-label: "Show folder";
    // an exams folder is open (Settings shows it, with Change… and the file manager)
    in property <bool> has-workspace;
    // settings: each applies at once and is saved for the next start
    in-out property <bool> single-key: true;
    in-out property <bool> show-all-default: false;
    // the name recorded in the audit trail (Settings, the field shows it until saved)
    in-out property <string> operator-name;
    // write the exports when a grading run, an added batch or a roster ends (Settings)
    in-out property <bool> auto-export: true;
    // the end of a background run (grading, scans added, a roster): what happened and the next
    // steps, on every screen until it is dismissed or a step leads to another screen
    in property <bool> notice-open;
    in property <string> notice-title;
    in property <string> notice-text;
    in property <Tone> notice-tone: Tone.neutral;
    // the steps' labels, the primary first
    in property <[string]> notice-steps;
    // closing the window while a run is in progress asks first: what runs, and whether the
    // window waits for a cancelled run to stop
    in property <bool> close-open;
    in property <string> close-text;
    in property <bool> closing;
    // the run has read its pages and is being saved (a cancel is too late): the window offers
    // to close once it is saved
    in property <bool> close-saving;
    callback navigate(Page);
    callback set-dark(bool);
    callback set-reduce-motion(bool);
    callback set-single-key(bool);
    callback set-show-all-default(bool);
    // validated by the core; recorded on every decision from now on
    callback set-operator(string);
    callback set-auto-export(bool);
    // a step of the notice (its index), or -1: the notice is dismissed
    callback notice-action(int);
    // closing while a run is in progress: 0 keep it running (the window stays), 1 cancel it
    // and close once it has stopped (a run being saved: close once it is saved)
    callback close-action(int);
    // shows a folder in the system's file manager: "exam" (the current exam's folder),
    // "exports" (the same folder, where its exports are written) or "workspace"
    callback reveal(string);
    // the folder dialog for another exams folder; what is chosen opens
    callback open-workspace();
    // reads the exams folder again (F5)
    callback refresh();
    // a command the shell forwards but the demo backend does not model (e.g. "New exam")
    callback request(string);
    // a path field's Browse… or Folder… button: opens the file dialog of that field
    // ("new-scans", "setup-key", …); what is picked fills the field
    callback browse(string);
    // global keys (Ctrl+1..6, Ctrl+0/Ctrl+comma, Escape); returns true when handled
    callback key(string, bool, bool, bool) -> bool;
}

// ------------------------------------------------------------------------------- exams

export struct ExamRow {
    id: string,
    code: string,
    title: string,
    title-ar: string,
    assessment: string,
    date: string,
    date-hijri: string,
    term: string,
    forms: [string],
    scanned: string,
    expected: string,
    progress: float,
    progress-tone: Tone,
    info: int,
    warn: int,
    error: int,
    blocker: int,
    status: string,
    status-tone: Tone,
    // accessible row label
    label: string,
}

export struct FilterChip {
    label: string,
    count: int,
}

export struct ExamDrawer {
    code: string,
    title: string,
    title-ar: string,
    assessment: string,
    status: string,
    status-tone: Tone,
    callout-title: string,
    callout-text: string,
    callout-tone: Tone,
    review-label: string,
    can-review: bool,
    // the key read from key sheets waits for its confirmation: the call-out leads to Setup
    to-setup: bool,
    key-status: string,
    // a key is in force (supplied or confirmed, not inferred): the key row shows a check
    key-ok: bool,
    mapped: int,
    mapped-word: string,
    total: int,
    roster: string,
    sections: string,
    last-scan: string,
    batch-id: string,
    term: string,
    term-ar: string,
}

// One value of the New-exam card.
export struct CardValue {
    // the field's name (`versions`) and label (`Versions`)
    field: string,
    label: string,
    value: string,
    source: string,
    detail: string,
    // 0 nothing to say, 1 a note, 2 a question open
    state: int,
    // the row's accessible text: "Versions: A, B — key file (…)"
    a11y: string,
}

// A question of the New-exam card (with its answers' button texts) or a note.
export struct CardIssue {
    field: string,
    label: string,
    text: string,
    choices: [string],
}

// What the card says of a field the instructor may type in.
export struct FieldHint {
    // the value proposed and its source ("30 · key file"; "" none)
    proposed: string,
    // a question open on the field ("" none)
    error: string,
}

// ------------------------------------------------------------------------------- setup

export global ExamsVM {
    in property <[ExamRow]> rows;
    in property <[FilterChip]> filters;
    in property <int> filter;
    in property <int> selected: -1;
    in property <bool> drawer-open;
    in property <ExamDrawer> drawer;
    in property <string> sheets-week;
    in property <string> sheets-today;
    in property <string> open-exceptions;
    in property <string> open-errors;
    in property <string> median-review;
    in property <string> median-caption;
    in property <string> throughput;
    in property <string> throughput-caption;
    // the captions' tones: neutral when there is nothing to count
    in property <Tone> sheets-today-tone;
    in property <Tone> open-errors-tone;
    in property <string> term-label;
    // incremented by Rust on Ctrl+K: the dashboard focuses its search field
    in property <int> search-request;
    // the search field (Enter applies it: the table lists the exams whose course code, title or
    // assessment contains it), and the search the table applies ("" none)
    in-out property <string> search-text;
    in property <string> search-applied;
    callback search(string);
    // select the exam with this ID and open the drawer (click, Enter); an ID, not a row: a
    // refresh during a press may move another exam into the row pressed
    callback select(string);
    // move the selection by n rows, keeping the drawer as it is (↑ / ↓)
    callback move(int);
    callback set-filter(int);
    // open the selected exam on a page
    callback open(Page);
    // Setup, on the key summary that confirms a key read from key sheets
    callback confirm-key();
    callback close-drawer();
    // another exams folder can be opened and the folder read again (not the demo)
    in property <bool> can-open-workspace;
    // the New-exam card (G-3): the files the instructor gives and the values typed over the
    // proposed ones; Rust proposes every value from the evidence, each with its source, and
    // grades exactly what the card shows
    in-out property <bool> new-open;
    // the card can open (an exams folder to grade into)
    in property <bool> can-create;
    in property <string> new-note;
    in-out property <string> new-title;
    in-out property <string> new-course;
    in-out property <string> new-scans;
    in-out property <string> new-sheet: "iau-ccsit-v1";
    in-out property <string> new-questions;
    in-out property <string> new-options;
    in-out property <string> new-forms;
    in-out property <string> new-key;
    in-out property <string> new-roster;
    in-out property <string> new-clo;
    in-out property <string> new-key-sheets;
    in-out property <string> new-term;
    in-out property <string> new-id-scheme;
    in-out property <string> new-cancel-mode;
    in-out property <string> new-multi-review;
    in-out property <bool> new-high-stakes;
    in-out property <string> new-out;
    // Advanced options open (their fields exist only then), the notes unfolded
    in-out property <bool> new-advanced;
    in-out property <bool> new-notes-open;
    // every value as graded: value — source (evidence); the questions that stop grading until
    // answered (each with its one-click answers), and the notes
    in property <[CardValue]> card-values;
    in property <[CardIssue]> card-asks;
    in property <[CardIssue]> card-notes;
    // the scans being checked: 0 not yet (no scans), 1 checking, 2 checked, 3 not checked
    in property <int> survey-state;
    in property <string> survey-text;
    in property <float> survey-share;
    // why Grade exam waits ("": it can start)
    in property <string> new-block;
    // the printed sheet fixes how marks are cancelled (the IAU sheet: erasures cancel)
    in property <bool> cancel-locked;
    // per field the instructor may type in: the value proposed (its placeholder) and a question
    // open on it (shown under the field)
    in property <FieldHint> h-scans;
    in property <FieldHint> h-key;
    in property <FieldHint> h-key-sheets;
    in property <FieldHint> h-roster;
    in property <FieldHint> h-clo;
    in property <FieldHint> h-title;
    in property <FieldHint> h-course;
    in property <FieldHint> h-questions;
    in property <FieldHint> h-forms;
    in property <FieldHint> h-options;
    in property <FieldHint> h-sheet;
    in property <FieldHint> h-term;
    in property <FieldHint> h-id-scheme;
    in property <FieldHint> h-cancel-mode;
    in property <FieldHint> h-multi-review;
    in property <FieldHint> h-high-stakes;
    in property <FieldHint> h-out;
    // the field the keyboard goes to (`questions`), as an answer on the card asks; each ask
    // counts up `new-focus-gen`
    in-out property <string> new-focus;
    in property <int> new-focus-gen;
    callback create-exam();
    // the instructor edited a field (its name): the card is proposed again shortly
    callback form-changed(string);
    // answer `choice` (index) to question `ask` (index) of the card
    callback choose(int, int);
    callback stop-survey();
}

export struct MapCell {
    text: string,
    weight: float,
    mapped: bool,
    has-note: bool,
    selected: bool,
    label: string,
}

export struct MapRow {
    q: int,
    label: string,
    keys: [string],
    points: string,
    cells: [MapCell],
    sum: string,
    sum-ok: bool,
    status: string,
    status-tone: Tone,
}

export struct CloHead {
    code: string,
    domain: string,
    title: string,
    title-ar: string,
    plo: string,
    share: float,
    share-text: string,
    items: int,
}

export struct LintRow {
    code: string,
    severity: Severity,
    message: string,
}

export struct KV {
    label: string,
    value: string,
    tone: Tone,
}

// One version chip of the key read from key sheets.
export struct KsVersion {
    label: string,
    open: int,
    confirmed: bool,
    selected: bool,
    a11y: string,
}

// One question of a version's key read from key sheets (§10.1). `choices` are the option
// letters offered on a row that waits for the instructor; `pick` is the decision taken here and
// not confirmed yet ("" none, "B", "A|C", "*").
export struct KsRow {
    q: string,
    read: string,
    answer: string,
    status: string,
    status-tone: Tone,
    open: bool,
    highlight: bool,
    pick: string,
    // the options marked on a several-marks row, offered as "Accept A|C" ("" none)
    marked: string,
    detail: string,
    // the exam's key entry now, when it differs from the sheet ("" when equal or none)
    key-now: string,
    has-crop: bool,
    label: string,
}

// One key-sheet scan (file and page) with what the recognizer saw on it.
export struct KsScan {
    label: string,
    origin: string,
    id-read: string,
    version: string,
    registration: string,
    refusal: string,
}

export global SetupVM {
    in property <bool> available;
    // why an open exam has no setup to show (being graded, grading failed)
    in property <string> empty-text;
    in property <bool> has-roster;
    in property <[KV]> template;
    in property <string> template-id;
    in property <string> template-kind;
    in property <[string]> versions;
    in property <[string]> options;
    in property <string> key-status;
    in property <bool> key-published;
    in property <string> mapping-mode;
    in property <[CloHead]> clos;
    in property <[MapRow]> rows;
    in property <[LintRow]> lints;
    in property <int> sel-row;
    in property <int> sel-col;
    in property <string> sel-title;
    in property <string> sel-clo;
    in property <string> sel-weight;
    in property <string> sel-note;
    in property <string> error;
    // replace the whole key from a key file (CSV, TSV, any layout `omr grade` reads)
    in-out property <bool> key-open;
    in-out property <string> key-path;
    in property <bool> can-replace-key;
    callback replace-key(string);
    // the key read from the instructor's filled answer sheets (§10.1): never auto-accepted,
    // confirmed here
    in property <bool> can-read-keysheets;
    in-out property <bool> ks-bar-open;
    in-out property <string> ks-path;
    in property <bool> has-keysheets;
    in-out property <bool> ks-open;
    in property <string> ks-source;
    in property <bool> ks-preview;
    in property <bool> ks-pending;
    in property <[KsVersion]> ks-versions;
    in property <int> ks-version;
    in property <string> ks-version-letter;
    in property <string> ks-version-title;
    in property <string> ks-version-status;
    in property <[KsRow]> ks-rows;
    in property <[image]> ks-crops;
    in property <[string]> ks-option-labels;
    in property <[KsScan]> ks-scans;
    in property <[string]> ks-notes;
    in property <string> ks-consequence;
    in property <string> ks-confirm-label;
    in property <bool> ks-can-confirm;
    in property <bool> ks-can-confirm-all;
    in property <bool> ks-confirmed;
    callback ks-read(string);
    callback ks-select-version(int);
    // row, option (0-based); -1 void, -2 accept every marked option
    callback ks-choose(int, int);
    callback ks-confirm(bool);
    callback ks-discard();
    callback cycle-key(int, int);
    // row, version, the typed key (empty clears it); false when the text is no key entry (a
    // key that types nothing), so the key goes on to the screen
    callback set-key(int, int, string) -> bool;
    callback set-weight(int, int, string);
    callback set-note(int, int, string);
    // a roster for the graded exam (step 4 Roster): every booklet is matched again in the
    // background, review decisions carried over
    in property <bool> can-set-roster;
    in property <string> roster-status;
    in-out property <bool> roster-open;
    in-out property <string> roster-path;
    callback set-roster(string);
    // imported item → CLO rows waiting for approval (§11.2), and a CLO file to replace them
    in property <int> mappings-proposed;
    in-out property <string> clo-path;
    callback approve-mappings();
    callback replace-clos(string);
    callback select-cell(int, int);
}

// ------------------------------------------------------------------- Remark migration

// One version of a Remark import (segment label and its facts).
export struct RmVersion {
    label: string,
    selected: bool,
    a11y: string,
}

// One question of the version shown: the key entry (hidden until revealed), its exact points
// and its learning objective.
export struct RmRow {
    q: string,
    key: string,
    points: string,
    objective: string,
}

// A learning objective imported as a CLO with weight-1 mappings, "imported, needs review".
export struct RmObjective {
    code: string,
    label: string,
    detail: string,
}

// A workbook row Remark graded as a student that is the instructor's key sheet: excluded.
export struct RmKeySheet {
    title: string,
    detail: string,
}

// A question to adjudicate in the parallel run, with its bubble-row crop.
export struct CmpDiff {
    q: string,
    booklet: string,
    student: string,
    remark: string,
    ours: string,
    status: string,
    tone: Tone,
    findings: string,
    has-crop: bool,
    label: string,
}

// A line of a parallel-run card (identity difference, total, key-sheet effect, workbook).
export struct CmpLine {
    title: string,
    detail: string,
    tone: Tone,
}

export struct CmpTile {
    label: string,
    value: string,
    caption: string,
    tone: Tone,
}

// The Remark migration (spec §3.5, PAR-09; §23.7): the import read on the New-exam form or in
// Setup (shown for review, applied by the instructor), and the parallel run in Results.
export global RemarkVM {
    // which import the fields show: 0 none, 1 the New-exam form's, 2 the current exam's (Setup)
    in property <int> context;
    in property <bool> can-new;
    in property <bool> can-setup;
    // the import panel inside the New-exam form, the Setup bar and its summary
    in-out property <bool> new-panel;
    in-out property <bool> setup-bar;
    in-out property <bool> setup-open;
    in-out property <string> path;
    in-out property <string> points-path;
    in property <bool> has;
    in property <bool> refused;
    in property <string> refusal;
    in property <string> remedy;
    in property <string> suggestion;
    in property <string> title;
    in property <string> files;
    in property <[RmVersion]> versions;
    in property <int> version;
    in property <[KV]> facts;
    in property <string> key-counts;
    in property <[RmRow]> rows;
    in property <[RmObjective]> objectives;
    in property <[RmKeySheet]> key-sheets;
    in property <[KV]> workbooks;
    in property <[string]> notes;
    in property <string> applies;
    in property <bool> can-apply;
    in property <string> apply-label;
    in-out property <bool> show-key;
    // the New-exam form uses the import (its key, points and learning objectives)
    in property <bool> new-using;
    in property <string> new-using-text;
    callback read(string, string);
    callback use-suggested();
    callback select-version(int);
    callback apply();
    callback discard();
    callback clear-new();
    // the parallel run in Results (Restricted; head-to-head figures stay inside the university)
    in property <bool> can-compare;
    in-out property <bool> cmp-bar;
    in-out property <bool> cmp-open;
    in-out property <string> cmp-path;
    in property <bool> cmp-has;
    in property <string> banner;
    in property <bool> cmp-refused;
    in property <string> cmp-refusal;
    in property <string> cmp-remedy;
    in property <string> cmp-suggestion;
    in property <string> cmp-title;
    in property <string> cmp-points;
    in property <[CmpTile]> cmp-tiles;
    in property <[CmpDiff]> diffs;
    in property <[image]> diff-crops;
    in property <[CmpLine]> identity;
    in property <[CmpLine]> totals;
    in property <[CmpLine]> cmp-key-sheets;
    in property <[CmpLine]> cmp-workbooks;
    // what holds release: the differences queued in Review, or nothing (the report alone)
    in property <string> cmp-hold;
    in property <bool> cmp-can-queue;
    in-out property <string> save-path;
    callback compare(string);
    callback cmp-use-suggested();
    callback cmp-use-exam-points();
    callback save(string);
    callback queue();
}

// ------------------------------------------------------------------------------- scan

export struct Thumb {
    serial: string,
    // 0 auto, 1 review, 2 rejected, 3 reading, 4 queued, 5 key sheet (never a student),
    // 6 key sheet that gives no key
    state: int,
    code: string,
    severity: Severity,
    variant: int,
    label: string,
    // the sheet's own open item (the one whose code the tile shows), -1 none
    item: int,
}

export struct CodeBar {
    code: string,
    title: string,
    severity: Severity,
    count: int,
    frac: float,
}

export global ScanVM {
    in property <bool> available;
    // why an open exam has no batch to show (grading failed, the project cannot be opened)
    in property <string> empty-text;
    in property <string> batch-label;
    in property <string> source;
    in property <string> device;
    in property <bool> running;
    in property <float> pps;
    in property <float> pps-max: 120;
    in property <float> pps-floor: 40;
    in property <string> pps-text;
    in property <string> pages-value;
    in property <string> pages-caption;
    in property <string> auto-value;
    in property <string> auto-caption;
    in property <string> first-value;
    in property <string> first-caption;
    // success under the 3 s target, a warning over it, neutral before the first result
    in property <Tone> first-tone;
    in property <string> remaining-value;
    in property <string> remaining-caption;
    in property <float> done-frac;
    in property <float> flight-frac;
    in property <[KV]> stages;
    // the worst codes (at most 7 rows fit the column at 1280 × 800); the rest are counted
    in property <[CodeBar]> codes;
    in property <int> codes-more;
    in property <[Thumb]> thumbs;
    in property <[image]> thumb-images;
    in property <string> auto-count;
    in property <string> review-count;
    in property <string> rejected-count;
    in property <int> key-sheet-count;
    in property <[KV]> recon;
    in property <string> recon-code;
    in property <Severity> recon-severity;
    in property <[string]> activity;
    in property <string> engine;
    in property <int> workers;
    in property <int> review-open;
    // a capture agent runs the batch (Pause and Stop); file imports cannot be paused
    in property <bool> pausable;
    // a new exam being graded can be cancelled (nothing is saved): the bar asks first
    in property <bool> can-cancel;
    in-out property <bool> cancel-confirm;
    callback cancel-job();
    // adding a later batch (another section, another day) to this exam, §8.1
    in property <bool> can-add;
    in property <string> add-note;
    in-out property <bool> add-open;
    in-out property <string> add-path;
    callback add-scans(string);
    callback toggle-pause();
    callback open-review();
    callback open-code(string);
    // a thumbnail: its serial, worst open code ("" when none) and that code's item of this
    // sheet (-1 none)
    callback open-sheet(string, string, int);
}

// ------------------------------------------------------------------------------- review

export struct LaneChip {
    label: string,
    count: int,
    selected: bool,
}

export struct QueueEntry {
    header: bool,
    code: string,
    title: string,
    severity: Severity,
    count: int,
    expanded: bool,
    // row handle: index into the shell's item list (never a raw item id)
    id: int,
    label: string,
    detail: string,
    serial: string,
    fills: [float],
    selected: bool,
    blind: bool,
    deferred: bool,
    a11y: string,
}

