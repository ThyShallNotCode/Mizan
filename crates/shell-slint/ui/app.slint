// Mizan desktop shell: frame, navigation rail and screen switch (DESIGN §9).
// Screens are instantiated only while visible, so accessible labels stay unique per screen.
// Every screen gets the window size: it fits 1440 × 900 nominal and 1280 × 800 minimum (DESIGN
// §9). The size reaches the screens as a copy written when the platform resizes the window, not
// as a binding: `win-w: root.width` would close a loop (the window's layout constraints depend on
// the screens, whose layout depends on the width), which Slint 1.18 deprecates and may panic on.

import { Theme, Tone, NavRail, NavItem } from "theme.slint";
import { App, ExamsVM, SetupVM, ScanVM, ReviewVM, ResultsVM, OutcomesVM, RemarkVM, Page } from "state.slint";
import { Icons } from "widgets.slint";
import { ExamsScreen } from "screens/exams.slint";
import { SetupScreen } from "screens/setup.slint";
import { ScanScreen } from "screens/scan.slint";
import { ReviewScreen } from "screens/review.slint";
import { ResultsScreen } from "screens/results.slint";
import { OutcomesScreen } from "screens/outcomes.slint";
import { SettingsScreen } from "screens/settings.slint";
import { Palette } from "std-widgets.slint";

export { Theme, App, ExamsVM, SetupVM, ScanVM, ReviewVM, ResultsVM, OutcomesVM, RemarkVM, Page }

export component AppWindow inherits Window {
    title: "Mizan";
    icon: @image-url("assets/icon.png");
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 1280px;
    min-height: 800px;
    default-font-family: Theme.font-sans;
    default-font-size: Theme.text-sm;
    background: Theme.canvas;
    forward-focus: root-keys;

    // The window size for the screens (see the header): copied, never bound.
    property <length> win-w: 1440px;
    property <length> win-h: 900px;
    init => {
        self.win-w = self.width;
        self.win-h = self.height;
    }
    changed width => {
        self.win-w = self.width;
    }
    changed height => {
        self.win-h = self.height;
    }

    // std-widgets (ListView scrollbars) follow the app theme
    property <bool> dark: Theme.dark;
    changed dark => {
        Palette.color-scheme = self.dark ? ColorScheme.dark : ColorScheme.light;
    }

    // A page change destroys the previous screen and the control that had focus with it: hand
    // focus back to the window's key scope so the keyboard keeps working (WCAG 2.1.1, 2.4.3).
    // Review focuses its own canvas when it is created.
    property <Page> page: App.page;
    changed page => {
        if (self.page != Page.review) {
            root-keys.focus();
        }
    }

    root-keys := FocusScope {
        key-pressed(event) => {
            if (App.key(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt)) {
                return accept;
            }
            return reject;
        }
        HorizontalLayout {
            NavRail {
                accessible-role: AccessibleRole.navigation;
                accessible-label: "Main navigation";
                Rectangle {
                    height: 56px;
                    Image {
                        width: 36px;
                        height: 36px;
                        source: Icons.logo;
                        accessible-role: AccessibleRole.image;
                        accessible-label: "Mizan";
                    }
                }
                NavItem {
                    icon: Icons.exams;
                    label: "Exams";
                    active: App.page == Page.exams;
                    clicked => {
                        App.navigate(Page.exams);
                    }
                }
                NavItem {
                    icon: Icons.setup;
                    label: "Setup";
                    active: App.page == Page.setup;
                    clicked => {
                        App.navigate(Page.setup);
                    }
                }
                NavItem {
                    icon: Icons.scan;
                    label: "Scan";
                    active: App.page == Page.scan;
                    clicked => {
                        App.navigate(Page.scan);
                    }
                }
                NavItem {
                    icon: Icons.review;
                    label: "Review";
                    badge: App.review-open > 0 ? "\{App.review-open}" : "";
                    active: App.page == Page.review;
                    clicked => {
                        App.navigate(Page.review);
                    }
                }
                NavItem {
                    icon: Icons.results;
                    label: "Results";
                    active: App.page == Page.results;
                    clicked => {
                        App.navigate(Page.results);
                    }
                }
                NavItem {
                    icon: Icons.outcomes;
                    label: "Outcomes";
                    active: App.page == Page.outcomes;
                    clicked => {
                        App.navigate(Page.outcomes);
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                }
                // demo data is never mistaken for an exam: a mark on every screen (`--demo`),
                // in the rail so no screen loses height
                if App.demo: Rectangle {
                    height: 44px;
                    border-radius: Theme.radius-sm;
                    background: Theme.tone-fg(Tone.warning);
                    accessible-role: AccessibleRole.text;
                    accessible-label: "Demo data: invented exams, nothing is read or written. Open your exams with omr-desktop --workspace FOLDER";
                    Text {
                        text: "DEMO\nDATA";
                        color: Theme.surface;
                        font-size: Theme.text-xs;
                        font-weight: Theme.weight-semibold;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                NavItem {
                    icon: Icons.settings;
                    label: "Settings";
                    active: App.page == Page.settings;
                    clicked => {
                        App.navigate(Page.settings);
                    }
                }
            }
            if App.page == Page.exams: ExamsScreen {
                horizontal-stretch: 1;
                win-w: root.win-w;
                win-h: root.win-h;
            }
            if App.page == Page.setup: SetupScreen {
                horizontal-stretch: 1;
                win-w: root.win-w;
                win-h: root.win-h;
            }
            if App.page == Page.scan: ScanScreen {
                horizontal-stretch: 1;
                win-w: root.win-w;
                win-h: root.win-h;
            }
            if App.page == Page.review: ReviewScreen {
                horizontal-stretch: 1;
                win-w: root.win-w;
                win-h: root.win-h;
            }
            if App.page == Page.results: ResultsScreen {
                horizontal-stretch: 1;
                win-w: root.win-w;
                win-h: root.win-h;
            }
            if App.page == Page.outcomes: OutcomesScreen {
                horizontal-stretch: 1;
                win-w: root.win-w;
                win-h: root.win-h;
            }
            if App.page == Page.settings: SettingsScreen {
                horizontal-stretch: 1;
                win-w: root.win-w;
                win-h: root.win-h;
            }
        }
    }
}
