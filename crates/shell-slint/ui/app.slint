// Mizan desktop shell: frame, navigation rail and screen switch (DESIGN §9).
// Screens are instantiated only while visible, so accessible labels stay unique per screen.
// Every screen gets the window size: it fits 1440 × 900 nominal and 1280 × 800 minimum (DESIGN
// §9). The size reaches the screens as a copy written when the platform resizes the window, not
// as a binding: `win-w: root.width` would close a loop (the window's layout constraints depend on
// the screens, whose layout depends on the width), which Slint 1.18 deprecates and may panic on.

import {
    Theme, Tone, NavRail, NavItem, PrimaryButton, SecondaryButton, DangerButton, Button, ButtonKind,
    IconButton,
} from "theme.slint";
import { App, ExamsVM, SetupVM, ScanVM, ReviewVM, ResultsVM, OutcomesVM, RemarkVM, Page } from "state.slint";
import { Icons, Centered } from "widgets.slint";
import { ExamsScreen } from "screens/exams.slint";
import { SetupScreen } from "screens/setup.slint";
import { ScanScreen } from "screens/scan.slint";
import { ReviewScreen } from "screens/review.slint";
import { ResultsScreen } from "screens/results.slint";
import { OutcomesScreen } from "screens/outcomes.slint";
import { SettingsScreen } from "screens/settings.slint";
import { Palette } from "std-widgets.slint";

export { Theme, App, ExamsVM, SetupVM, ScanVM, ReviewVM, ResultsVM, OutcomesVM, RemarkVM, Page }

// The end of a background run (a new exam graded, scans added, a roster), on every screen: what
// happened, what waits, and the next steps, the primary first. Dismissed with ×, or by a step
// that leads to another screen. It floats above the status bar, so no screen loses height.
component Notice inherits Rectangle {
    background: Theme.surface-raised;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: Theme.shadow-2-blur;
    drop-shadow-offset-y: Theme.shadow-2-offset;
    drop-shadow-color: Theme.shadow-2-color;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: App.notice-title;
    accessible-description: App.notice-text;
    // a press on its background never reaches the screen underneath
    TouchArea { }
    HorizontalLayout {
        padding-left: Theme.space-lg;
        padding-right: Theme.space-md;
        padding-top: Theme.space-md;
        padding-bottom: Theme.space-md;
        spacing: Theme.space-md;
        // the tone (success, warning, error) is also said in words: colour is never the only cue
        Rectangle {
            width: 4px;
            border-radius: 2px;
            background: Theme.tone-fg(App.notice-tone);
        }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 240px;
            alignment: center;
            spacing: 2px;
            Text {
                text: App.notice-title;
                font-size: Theme.text-sm;
                font-weight: Theme.weight-semibold;
                color: Theme.ink;
                wrap: word-wrap;
                accessible-role: none;
            }
            Text {
                text: App.notice-text;
                font-size: Theme.text-xs;
                color: Theme.ink-2;
                wrap: word-wrap;
                accessible-role: none;
            }
        }
        for step[i] in App.notice-steps: Centered {
            Button {
                kind: i == 0 ? ButtonKind.primary : ButtonKind.secondary;
                text: step;
                clicked => {
                    App.notice-action(i);
                }
            }
        }
        Centered {
            IconButton {
                icon: Icons.close;
                label: "Dismiss the notice";
                clicked => {
                    App.notice-action(-1);
                }
            }
        }
    }
}

// Closing the window while a run is in progress asks first: keep it running, or cancel it and
// close once it has stopped (nothing half-saved is left behind); a run that has read its pages
// is being saved and kept, and the window offers to close once it is saved.
component CloseConfirm inherits Rectangle {
    background: Theme.scrim;
    // modal: nothing underneath takes a press or a wheel turn
    TouchArea {
        scroll-event(event) => {
            return accept;
        }
    }
    card := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 3;
        width: 520px;
        height: self.preferred-height;
        background: Theme.surface-raised;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: Theme.shadow-2-blur;
        drop-shadow-offset-y: Theme.shadow-2-offset;
        drop-shadow-color: Theme.shadow-2-color;
        accessible-role: AccessibleRole.groupbox;
        accessible-label: "Close Mizan?";
        accessible-description: App.close-text;
        VerticalLayout {
            padding: Theme.space-lg;
            spacing: Theme.space-md;
            Text {
                text: !App.closing ? "Close Mizan?" : App.close-saving ? "Saving…" : "Cancelling…";
                font-size: Theme.text-md;
                font-weight: Theme.weight-semibold;
                color: Theme.ink;
                accessible-role: none;
            }
            Text {
                text: App.close-text;
                font-size: Theme.text-sm;
                color: Theme.ink-2;
                wrap: word-wrap;
                accessible-role: none;
            }
            if !App.closing: HorizontalLayout {
                alignment: end;
                spacing: Theme.space-sm;
                SecondaryButton {
                    text: "Keep it running";
                    init => {
                        self.focus();
                    }
                    clicked => {
                        App.close-action(0);
                    }
                }
                if !App.close-saving: DangerButton {
                    text: "Cancel it and close";
                    clicked => {
                        App.close-action(1);
                    }
                }
                // too late to cancel: the run is kept, and the window waits for it
                if App.close-saving: PrimaryButton {
                    text: "Close once saved";
                    clicked => {
                        App.close-action(1);
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Mizan";
    icon: @image-url("assets/icon.svg");
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 1280px;
    min-height: 800px;
    default-font-family: Theme.font-sans;
    default-font-size: Theme.text-sm;
    background: Theme.canvas;
    forward-focus: root-keys;

    // The window size for the screens (see the header): copied, never bound.
    property <length> win-w: 1440px;
    property <length> win-h: 900px;
    init => {
        self.win-w = self.width;
        self.win-h = self.height;
    }
    changed width => {
        self.win-w = self.width;
    }
    changed height => {
        self.win-h = self.height;
    }

    // std-widgets (ListView scrollbars) follow the app theme
    property <bool> dark: Theme.dark;
    changed dark => {
        Palette.color-scheme = self.dark ? ColorScheme.dark : ColorScheme.light;
    }

    // A page change destroys the previous screen and the control that had focus with it: hand
    // focus back to the window's key scope so the keyboard keeps working (WCAG 2.1.1, 2.4.3).
    // Review focuses its own canvas when it is created.
    property <Page> page: App.page;
    changed page => {
        if (self.page != Page.review) {
            root-keys.focus();
        }
    }

    root-keys := FocusScope {
        key-pressed(event) => {
            if (App.key(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt)) {
                return accept;
            }
            return reject;
        }
        HorizontalLayout {
            NavRail {
                accessible-role: AccessibleRole.navigation;
                accessible-label: "Main navigation";
                Rectangle {
                    height: 56px;
                    Image {
                        width: 36px;
                        height: 36px;
                        source: Icons.logo;
                        accessible-role: AccessibleRole.image;
                        accessible-label: "Mizan";
                    }
                }
                NavItem {
                    icon: Icons.exams;
                    label: "Exams";
                    active: App.page == Page.exams;
                    clicked => {
                        App.navigate(Page.exams);
                    }
                }
                NavItem {
                    icon: Icons.setup;
                    label: "Setup";
                    active: App.page == Page.setup;
                    clicked => {
                        App.navigate(Page.setup);
                    }
                }
                NavItem {
                    icon: Icons.scan;
                    label: "Scan";
                    active: App.page == Page.scan;
                    clicked => {
                        App.navigate(Page.scan);
                    }
                }
                NavItem {
                    icon: Icons.review;
                    label: "Review";
                    badge: App.review-open > 0 ? "\{App.review-open}" : "";
                    active: App.page == Page.review;
                    clicked => {
                        App.navigate(Page.review);
                    }
                }
                NavItem {
                    icon: Icons.results;
                    label: "Results";
                    active: App.page == Page.results;
                    clicked => {
                        App.navigate(Page.results);
                    }
                }
                NavItem {
                    icon: Icons.outcomes;
                    label: "Outcomes";
                    active: App.page == Page.outcomes;
                    clicked => {
                        App.navigate(Page.outcomes);
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                }
                // demo data is never mistaken for an exam: a mark on every screen (`--demo`),
                // in the rail so no screen loses height
                if App.demo: Rectangle {
                    height: 44px;
                    border-radius: Theme.radius-sm;
                    background: Theme.tone-fg(Tone.warning);
                    accessible-role: AccessibleRole.text;
                    accessible-label: "Demo data: invented exams, nothing is read or written. Open your exams with omr-desktop --workspace FOLDER";
                    Text {
                        text: "DEMO\nDATA";
                        color: Theme.surface;
                        font-size: Theme.text-xs;
                        font-weight: Theme.weight-semibold;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                NavItem {
                    icon: Icons.settings;
                    label: "Settings";
                    active: App.page == Page.settings;
                    clicked => {
                        App.navigate(Page.settings);
                    }
                }
            }
            if App.page == Page.exams: ExamsScreen {
                horizontal-stretch: 1;
                win-w: root.win-w;
                win-h: root.win-h;
            }
            if App.page == Page.setup: SetupScreen {
                horizontal-stretch: 1;
                win-w: root.win-w;
                win-h: root.win-h;
            }
            if App.page == Page.scan: ScanScreen {
                horizontal-stretch: 1;
                win-w: root.win-w;
                win-h: root.win-h;
            }
            if App.page == Page.review: ReviewScreen {
                horizontal-stretch: 1;
                win-w: root.win-w;
                win-h: root.win-h;
            }
            if App.page == Page.results: ResultsScreen {
                horizontal-stretch: 1;
                win-w: root.win-w;
                win-h: root.win-h;
            }
            if App.page == Page.outcomes: OutcomesScreen {
                horizontal-stretch: 1;
                win-w: root.win-w;
                win-h: root.win-h;
            }
            if App.page == Page.settings: SettingsScreen {
                horizontal-stretch: 1;
                win-w: root.win-w;
                win-h: root.win-h;
            }
        }
        // inside the window's key scope, so the keys keep working after a click on it
        if App.notice-open: Notice {
            x: Theme.nav-rail-width + Theme.space-xl;
            width: root.win-w - Theme.nav-rail-width - 2 * Theme.space-xl;
            height: self.preferred-height;
            y: root.win-h - Theme.status-bar-height - Theme.space-md - self.height;
        }
        if App.close-open: CloseConfirm {
            x: 0;
            y: 0;
            width: root.win-w;
            height: root.win-h;
        }
    }
}

// Shown instead of the main window when Mizan cannot start: the Windows release build has no
// console window to print the reason to.
export component ErrorWindow inherits Window {
    in property <string> heading: "Mizan cannot start";
    in property <string> message;
    callback close();
    title: "Mizan";
    icon: @image-url("assets/icon.svg");
    preferred-width: 600px;
    min-width: 420px;
    default-font-family: Theme.font-sans;
    default-font-size: Theme.text-md;
    background: Theme.surface;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        Text {
            text: root.heading;
            font-size: Theme.text-lg;
            font-weight: Theme.weight-semibold;
            color: Theme.ink;
            accessible-role: AccessibleRole.text;
        }
        Text {
            text: root.message;
            wrap: word-wrap;
            color: Theme.ink-2;
            accessible-role: AccessibleRole.text;
        }
        HorizontalLayout {
            alignment: end;
            PrimaryButton {
                text: "Close";
                clicked => {
                    root.close();
                }
            }
        }
    }
}
