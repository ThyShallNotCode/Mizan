// Exams dashboard (DESIGN §9.1, concept exams-dashboard.png).

import {
    Theme, Tone, Severity, Card, StatTile, GirihDivider, TopBar, StatusBar, SearchField, PrimaryButton,
    SecondaryButton, GhostButton, IconButton, Chip, StatusPill, Tag, ProgressBar, TableRow,
    TableHeaderCell, TableCell, SeverityGlyph,
} from "../theme.slint";
import { App, ExamsVM, ExamRow, Page, RemarkVM, CardValue, CardIssue } from "../state.slint";
import { RemarkFields, RemarkRefusal, RemarkImportCard, RemarkSideCard } from "remark.slint";
import {
    Icons, ThemeToggle, Centered, KVLine, SectionLabel, StatusText, SeverityStack, SeverityCount,
    CoverageRing, Avatar, MessageText, PathField, EmptyState, Switch, Segment, SegmentGroup,
} from "../widgets.slint";
import { ListView, ScrollView } from "std-widgets.slint";

component ExamTableRow inherits TableRow {
    in property <ExamRow> data;
    row-height: 56px;
    accessible-label: root.data.label;
    Rectangle {
        horizontal-stretch: 1;
        min-width: 220px;
        VerticalLayout {
            padding-left: Theme.space-md;
            padding-right: Theme.space-sm;
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: Theme.space-sm;
                Text {
                    text: root.data.code;
                    font-family: Theme.font-mono;
                    font-size: Theme.text-sm;
                    font-weight: Theme.weight-semibold;
                    color: Theme.primary;
                    vertical-alignment: center;
                }
                Text {
                    text: root.data.title;
                    font-size: Theme.text-sm;
                    font-weight: Theme.weight-medium;
                    color: Theme.ink;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
            // Arabic title: its own run in the Arabic face, shaped RTL, left-aligned with the column
            Text {
                text: root.data.title-ar;
                font-family: Theme.font-arabic;
                font-size: Theme.text-xs;
                color: Theme.ink-2;
                horizontal-alignment: left;
                overflow: elide;
            }
        }
    }
    TableCell {
        width: 104px;
        text: root.data.assessment;
        tint: Theme.ink;
    }
    TableCell {
        width: 116px;
        text: root.data.date;
        secondary: root.data.date-hijri;
        mono: true;
    }
    Rectangle {
        width: 100px;
        HorizontalLayout {
            padding-left: Theme.space-md;
            spacing: 3px;
            alignment: start;
            for f in root.data.forms: Centered {
                Tag {
                    text: f;
                }
            }
        }
    }
    Rectangle {
        width: 124px;
        VerticalLayout {
            padding-left: Theme.space-md;
            padding-right: Theme.space-md;
            alignment: center;
            spacing: 5px;
            HorizontalLayout {
                spacing: 2px;
                Text {
                    text: root.data.scanned;
                    font-family: Theme.font-mono;
                    font-size: Theme.text-sm;
                    font-weight: Theme.weight-medium;
                    color: Theme.ink;
                }
                Text {
                    text: " / " + root.data.expected;
                    font-family: Theme.font-mono;
                    font-size: Theme.text-xs;
                    color: Theme.ink-2;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
            ProgressBar {
                value: root.data.progress;
                tone: root.data.progress-tone;
                thickness: 4px;
            }
        }
    }
    Rectangle {
        width: 148px;
        VerticalLayout {
            padding-left: Theme.space-md;
            padding-right: Theme.space-md;
            alignment: center;
            spacing: 5px;
            if root.data.error + root.data.blocker + root.data.warn + root.data.info == 0: Text {
                text: "None";
                font-size: Theme.text-sm;
                color: Theme.ink-3;
            }
            if root.data.error + root.data.blocker + root.data.warn + root.data.info > 0: SeverityStack {
                blocker: root.data.blocker;
                error: root.data.error;
                warn: root.data.warn;
                info: root.data.info;
            }
            if root.data.error + root.data.blocker + root.data.warn + root.data.info > 0: HorizontalLayout {
                spacing: Theme.space-sm;
                alignment: start;
                if root.data.error + root.data.blocker > 0: SeverityCount {
                    severity: Severity.error;
                    count: root.data.error + root.data.blocker;
                }
                if root.data.warn > 0: SeverityCount {
                    severity: Severity.warn;
                    count: root.data.warn;
                }
                if root.data.info > 0: SeverityCount {
                    severity: Severity.info;
                    count: root.data.info;
                }
            }
        }
    }
    Rectangle {
        width: 120px;
        HorizontalLayout {
            padding-left: Theme.space-md;
            alignment: start;
            Centered {
                StatusPill {
                    text: root.data.status;
                    tone: root.data.status-tone;
                }
            }
        }
    }
}

component Drawer inherits Rectangle {
    // tighter rhythm below 880 px so the drawer fits 800 px windows (DESIGN §9)
    in property <bool> short;
    width: Theme.drawer-width;
    background: Theme.surface;
    drop-shadow-blur: Theme.shadow-2-blur;
    drop-shadow-offset-x: -2px;
    drop-shadow-color: Theme.shadow-2-color;
    // Below 1420 px the drawer lies over the table: a press on its background must not select
    // the row underneath.
    TouchArea {
        scroll-event(event) => {
            return accept;
        }
    }
    Rectangle {
        x: 0;
        width: 1px;
        background: Theme.border;
    }
    VerticalLayout {
        // header
        VerticalLayout {
            padding: Theme.space-xl;
            padding-bottom: Theme.space-lg;
            spacing: Theme.space-xs;
            HorizontalLayout {
                spacing: Theme.space-sm;
                Text {
                    text: ExamsVM.drawer.code;
                    font-family: Theme.font-mono;
                    font-size: Theme.text-xl;
                    font-weight: Theme.weight-semibold;
                    color: Theme.primary;
                    vertical-alignment: center;
                }
                Centered {
                    Tag {
                        text: ExamsVM.drawer.assessment;
                        mono: false;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                IconButton {
                    icon: Icons.close;
                    label: "Close details (Esc)";
                    clicked => {
                        ExamsVM.close-drawer();
                    }
                }
            }
            Text {
                text: ExamsVM.drawer.title;
                font-size: Theme.text-md;
                font-weight: Theme.weight-medium;
                color: Theme.ink;
            }
            Text {
                text: ExamsVM.drawer.title-ar;
                font-family: Theme.font-arabic;
                font-size: Theme.text-sm;
                color: Theme.ink-2;
                horizontal-alignment: left;
            }
            HorizontalLayout {
                spacing: Theme.space-sm;
                Text {
                    text: ExamsVM.drawer.term;
                    font-size: Theme.text-xs;
                    color: Theme.ink-3;
                    vertical-alignment: center;
                }
                Text {
                    text: ExamsVM.drawer.term-ar;
                    font-family: Theme.font-arabic;
                    font-size: Theme.text-xs;
                    color: Theme.ink-3;
                    vertical-alignment: center;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.border;
        }
        VerticalLayout {
            padding: Theme.space-xl;
            padding-top: root.short ? Theme.space-lg : Theme.space-xl;
            spacing: root.short ? Theme.space-sm + 2px : Theme.space-lg;
            // status call-out
            Rectangle {
                border-radius: Theme.radius-lg;
                background: Theme.tone-soft(ExamsVM.drawer.callout-tone);
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-sm;
                    HorizontalLayout {
                        spacing: Theme.space-sm;
                        Centered {
                            StatusPill {
                                text: ExamsVM.drawer.status;
                                tone: ExamsVM.drawer.status-tone;
                            }
                        }
                        Text {
                            text: ExamsVM.drawer.callout-title;
                            font-size: Theme.text-sm;
                            font-weight: Theme.weight-semibold;
                            color: Theme.tone-fg(ExamsVM.drawer.callout-tone);
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    Text {
                        text: ExamsVM.drawer.callout-text;
                        font-size: Theme.text-sm;
                        color: Theme.ink;
                        wrap: word-wrap;
                    }
                    if ExamsVM.drawer.to-setup: PrimaryButton {
                        text: "Confirm the key in Setup";
                        icon: Icons.setup;
                        clicked => {
                            ExamsVM.confirm-key();
                        }
                    }
                    // the key comes first while it waits: the review is the second action then
                    if ExamsVM.drawer.can-review && !ExamsVM.drawer.to-setup: PrimaryButton {
                        text: ExamsVM.drawer.review-label;
                        icon: Icons.review;
                        key-hint: "Ctrl+4";
                        clicked => {
                            ExamsVM.open(Page.review);
                        }
                    }
                    if ExamsVM.drawer.can-review && ExamsVM.drawer.to-setup: SecondaryButton {
                        text: ExamsVM.drawer.review-label;
                        icon: Icons.review;
                        key-hint: "Ctrl+4";
                        clicked => {
                            ExamsVM.open(Page.review);
                        }
                    }
                }
            }
            SectionLabel {
                text: "CONFIGURATION";
            }
            // a check only for a key in force; an inferred key, one waiting for its
            // confirmation or none at all is a warning (shape and colour, WCAG 1.4.1)
            HorizontalLayout {
                spacing: Theme.space-sm;
                Centered {
                    if ExamsVM.drawer.key-ok: Image {
                        source: Icons.check;
                        width: 16px;
                        height: 16px;
                        colorize: Theme.success;
                    }
                    if !ExamsVM.drawer.key-ok: Rectangle {
                        width: 16px;
                        height: 16px;
                        SeverityGlyph {
                            severity: Severity.warn;
                            size: 12px;
                        }
                    }
                }
                Text {
                    text: "Answer key";
                    font-size: Theme.text-sm;
                    color: Theme.ink;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Centered {
                    Tag {
                        text: ExamsVM.drawer.key-status;
                        tone: ExamsVM.drawer.key-ok ? Tone.primary : Tone.warning;
                    }
                }
            }
            HorizontalLayout {
                spacing: Theme.space-sm;
                Centered {
                    Image {
                        source: Icons.outcomes;
                        width: 16px;
                        height: 16px;
                        colorize: Theme.ink-2;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: "CLO mapping";
                        font-size: Theme.text-sm;
                        color: Theme.ink;
                    }
                    Text {
                        text: ExamsVM.drawer.mapped + " of " + ExamsVM.drawer.total + " items " + ExamsVM.drawer.mapped-word;
                        font-size: Theme.text-xs;
                        color: Theme.ink-2;
                    }
                }
                CoverageRing {
                    value: ExamsVM.drawer.total > 0 ? ExamsVM.drawer.mapped / ExamsVM.drawer.total : 0;
                    text: ExamsVM.drawer.total > 0 ? round(100 * ExamsVM.drawer.mapped / ExamsVM.drawer.total) + "%" : "–";
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.border;
            }
            SectionLabel {
                text: "LOGISTICS";
            }
            KVLine {
                label: "Roster";
                value: ExamsVM.drawer.roster;
            }
            KVLine {
                label: "Sections";
                value: ExamsVM.drawer.sections;
            }
            KVLine {
                label: "Last scan";
                value: ExamsVM.drawer.last-scan;
            }
            KVLine {
                label: "Batch ID";
                value: ExamsVM.drawer.batch-id;
                mono: true;
            }
            Rectangle {
                vertical-stretch: 1;
            }
            HorizontalLayout {
                spacing: Theme.space-sm;
                SecondaryButton {
                    text: "Open results";
                    horizontal-stretch: 1;
                    clicked => {
                        ExamsVM.open(Page.results);
                    }
                }
                SecondaryButton {
                    text: "Exam setup";
                    horizontal-stretch: 1;
                    clicked => {
                        ExamsVM.open(Page.setup);
                    }
                }
            }
            GhostButton {
                text: "Scan and recognise";
                icon: Icons.scan;
                clicked => {
                    ExamsVM.open(Page.scan);
                }
            }
            // the exam's folder in the file manager: its project and the exports beside it
            if App.can-reveal: GhostButton {
                text: "Open exam folder";
                accessible-description: "Shows the folder of this exam, with its exports, in the file manager";
                clicked => {
                    App.reveal("exam");
                }
            }
        }
    }
}

// One labelled field of the New-exam card: the visible label above the field (the field's
// accessible label is the same text). A path field names its file dialogs (`target`,
// `folder-target`): Browse… (and Folder…) beside it when the window has them. An edit by the
// instructor is reported with the card's name of the field (`field`), and a question the card
// has open on the value is shown under it (`error`). The card asks for the keyboard by name
// (`ExamsVM.new-focus`).
component FormField inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <bool> mono: true;
    in property <bool> enabled: true;
    in property <string> target;
    in property <string> folder-target;
    // `target` opens a folder dialog
    in property <bool> folder;
    in property <string> field;
    in property <string> error;
    in-out property <string> text;
    out property <bool> has-focus: input.has-focus;
    callback accepted(string);
    forward-focus: input;
    spacing: 2px;
    property <int> focus-gen: ExamsVM.new-focus-gen;
    changed focus-gen => {
        if (ExamsVM.new-focus != "" && ExamsVM.new-focus == root.field) {
            ExamsVM.new-focus = "";
            input.focus();
        }
    }
    // a field made by the ask (under Advanced options) takes the keyboard as it appears
    init => {
        if (ExamsVM.new-focus != "" && ExamsVM.new-focus == root.field) {
            ExamsVM.new-focus = "";
            input.focus();
        }
    }
    Text {
        text: root.label;
        font-size: Theme.text-xs;
        font-weight: Theme.weight-semibold;
        color: Theme.ink-2;
        accessible-role: none;
    }
    input := PathField {
        label: root.label;
        placeholder: root.placeholder;
        text <=> root.text;
        mono: root.mono;
        enabled: root.enabled;
        target: root.target;
        folder-target: root.folder-target;
        folder: root.folder;
        invalid: root.error != "";
        description: root.error;
        accepted(v) => {
            root.accepted(v);
        }
        edited(v) => {
            ExamsVM.form-changed(root.field);
        }
    }
    if root.error != "": Text {
        text: root.error;
        font-size: Theme.text-xs;
        color: Theme.error;
        wrap: word-wrap;
        // the field's description carries it
        accessible-role: none;
    }
}

// One value of the card: its label, the value graded, where it came from and the evidence.
component CardRow inherits Rectangle {
    in property <CardValue> v;
    accessible-role: AccessibleRole.text;
    accessible-label: root.v.a11y;
    height: row.preferred-height;
    row := HorizontalLayout {
        spacing: Theme.space-sm;
        Text {
            width: 104px;
            text: root.v.label;
            font-size: Theme.text-xs;
            font-weight: Theme.weight-semibold;
            color: Theme.ink-2;
            accessible-role: none;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1px;
            Text {
                text: (root.v.value == "" ? "none" : root.v.value) + "  — " + root.v.source;
                font-size: Theme.text-xs;
                font-weight: Theme.weight-medium;
                color: root.v.state == 2 ? Theme.error : Theme.ink;
                wrap: word-wrap;
                accessible-role: none;
            }
            if root.v.detail != "": Text {
                text: root.v.detail;
                font-size: Theme.text-xs;
                color: Theme.ink-3;
                wrap: word-wrap;
                accessible-role: none;
            }
        }
        if root.v.state != 0: VerticalLayout {
            alignment: start;
            Text {
                text: root.v.state == 2 ? "question" : "note";
                font-size: Theme.text-xs;
                color: root.v.state == 2 ? Theme.error : Theme.ink-2;
                accessible-role: none;
            }
        }
    }
}

// A question of the card: what the evidence shows and what is at stake, and its one-click
// answers. Nothing is graded until it is answered.
component AskCard inherits Rectangle {
    in property <CardIssue> issue;
    in property <int> index;
    // a button inside has the keyboard
    callback focused(bool);
    background: Theme.warning-soft;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.warning;
    height: col.preferred-height;
    col := VerticalLayout {
        padding: Theme.space-sm;
        spacing: Theme.space-xs;
        Text {
            text: root.issue.label + ": " + root.issue.text;
            font-size: Theme.text-sm;
            color: Theme.ink;
            wrap: word-wrap;
        }
        for c[j] in root.issue.choices: HorizontalLayout {
            alignment: start;
            SecondaryButton {
                text: c;
                changed has-focus => {
                    root.focused(self.has-focus);
                }
                clicked => {
                    ExamsVM.choose(root.index, j);
                }
            }
        }
    }
}

// The New-exam card (G-3). Left, what the instructor gives: the scans (checked at once, in the
// background), the key file or key sheets, and any value typed over the proposed one (each
// field shows the proposed value until something is typed). Right, what is graded: every value
// with its source and evidence, the questions that stop grading until they are answered, and
// the notes. Rust proposes it all (omr-app) and grades exactly what it shows; Grade exam waits
// with the reason beside it.
component NewExamBar inherits Rectangle {
    // the height the card may take (it scrolls inside beyond it)
    in property <length> max-h: 800px;
    // what the instructor gives takes a fixed share: the evidence's long lines never squeeze
    // a path field
    property <length> give-w: max(460px, (root.width - 2 * Theme.space-lg) * 0.46);
    background: Theme.surface-raised;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: Theme.shadow-2-blur;
    drop-shadow-offset-y: Theme.shadow-2-offset;
    drop-shadow-color: Theme.shadow-2-color;
    init => {
        scans.focus();
    }
    property <bool> focus-inside: scans.has-focus || title.has-focus || course.has-focus || questions.has-focus || options.has-focus || forms.has-focus || key-file.has-focus || roster.has-focus || clo.has-focus || key-sheets.has-focus || advanced.has-focus || import.has-focus || cancel.has-focus || grade.has-focus || root.made-focused;
    // a control made and unmade with the card (an answer, Stop checking, Advanced options'
    // fields, the Remark import's Clear) has the keyboard (reset when one is made)
    property <bool> made-focused;
    // An overlay: a press on its background must not reach the page underneath. A click on it
    // gives the form the keyboard back (for Escape) unless a control inside has it.
    TouchArea {
        clicked => {
            if (!root.focus-inside) {
                scans.focus();
            }
        }
        scroll-event(event) => {
            return accept;
        }
    }
    FocusScope {
        // the fields inside keep focus when the bar's background is clicked
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                ExamsVM.new-open = false;
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            padding: Theme.space-lg;
            spacing: Theme.space-sm;
            head := HorizontalLayout {
                spacing: Theme.space-md;
                Text {
                    text: "New exam";
                    font-size: Theme.text-md;
                    font-weight: Theme.weight-semibold;
                    color: Theme.ink;
                    vertical-alignment: center;
                }
                Text {
                    horizontal-stretch: 1;
                    text: ExamsVM.new-note;
                    font-size: Theme.text-xs;
                    color: Theme.ink-2;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
            ScrollView {
                height: min(body.preferred-height, root.max-h - head.preferred-height - foot.preferred-height - 2 * Theme.space-lg - 2 * Theme.space-sm);
                content-width: self.visible-width;
                body := HorizontalLayout {
                    padding-right: Theme.space-md;
                    spacing: Theme.space-lg;
                    alignment: stretch;
                    // ---- what the instructor gives
                    VerticalLayout {
                        width: root.give-w;
                        alignment: start;
                        spacing: Theme.space-sm;
                        scans := FormField {
                            label: "Scan files or folders";
                            placeholder: "A folder or files of scans (PDF, TIFF, JPEG, PNG); separate several with ;";
                            target: "new-scans";
                            folder-target: "new-scan-folder";
                            field: "scans";
                            error: ExamsVM.h-scans.error;
                            text <=> ExamsVM.new-scans;
                        }
                        if ExamsVM.survey-state == 1: HorizontalLayout {
                            spacing: Theme.space-sm;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 3px;
                                Text {
                                    text: ExamsVM.survey-text;
                                    font-size: Theme.text-xs;
                                    color: Theme.ink-2;
                                    wrap: word-wrap;
                                }
                                ProgressBar {
                                    value: ExamsVM.survey-share;
                                    thickness: 4px;
                                    accessible-label: "Checking the scans";
                                }
                            }
                            Centered {
                                GhostButton {
                                    init => {
                                        root.made-focused = false;
                                    }
                                    changed has-focus => {
                                        root.made-focused = self.has-focus;
                                    }
                                    text: "Stop checking";
                                    accessible-description: "Stops reading the scans; nothing is graded until they are checked";
                                    clicked => {
                                        ExamsVM.stop-survey();
                                    }
                                }
                            }
                        }
                        if ExamsVM.survey-state == 2: Text {
                            text: ExamsVM.survey-text;
                            font-size: Theme.text-xs;
                            color: Theme.ink-2;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: Theme.space-md;
                            key-file := FormField {
                                horizontal-stretch: 1;
                                label: "Answer key file";
                                placeholder: ExamsVM.h-key.proposed != "" ? ExamsVM.h-key.proposed : "key.csv (optional)";
                                target: "new-key";
                                field: "key";
                                error: ExamsVM.h-key.error;
                                text <=> ExamsVM.new-key;
                            }
                            key-sheets := FormField {
                                horizontal-stretch: 1;
                                label: "Key sheets";
                                placeholder: ExamsVM.h-key-sheets.proposed != "" ? ExamsVM.h-key-sheets.proposed : "your filled answer sheets (optional)";
                                target: "new-key-sheets";
                                field: "key-sheets";
                                error: ExamsVM.h-key-sheets.error;
                                text <=> ExamsVM.new-key-sheets;
                            }
                        }
                        // the key, its points and the learning objectives from a Remark import (§3.5)
                        if RemarkVM.new-using: Rectangle {
                            background: Theme.accent-soft;
                            border-radius: Theme.radius-md;
                            accessible-role: AccessibleRole.text;
                            accessible-label: RemarkVM.new-using-text;
                            height: using.preferred-height;
                            using := HorizontalLayout {
                                padding-left: Theme.space-md;
                                padding-right: Theme.space-sm;
                                padding-top: Theme.space-xs;
                                padding-bottom: Theme.space-xs;
                                spacing: Theme.space-md;
                                Text {
                                    horizontal-stretch: 1;
                                    text: RemarkVM.new-using-text;
                                    font-size: Theme.text-xs;
                                    color: Theme.ink;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                    accessible-role: none;
                                }
                                Centered {
                                    GhostButton {
                                        init => {
                                            root.made-focused = false;
                                        }
                                        changed has-focus => {
                                            root.made-focused = self.has-focus;
                                        }
                                        text: "Clear the Remark import";
                                        accessible-description: "The card no longer uses the import: give a key file or key sheets";
                                        clicked => {
                                            RemarkVM.clear-new();
                                        }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-md;
                            title := FormField {
                                horizontal-stretch: 2;
                                label: "Exam title";
                                placeholder: ExamsVM.h-title.proposed != "" ? ExamsVM.h-title.proposed : "e.g. Midterm 2";
                                mono: false;
                                field: "title";
                                error: ExamsVM.h-title.error;
                                text <=> ExamsVM.new-title;
                            }
                            course := FormField {
                                horizontal-stretch: 1;
                                label: "Course code";
                                placeholder: ExamsVM.h-course.proposed != "" ? ExamsVM.h-course.proposed : "e.g. CS 101";
                                mono: false;
                                field: "course";
                                error: ExamsVM.h-course.error;
                                text <=> ExamsVM.new-course;
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-md;
                            questions := FormField {
                                horizontal-stretch: 1;
                                label: "Number of questions";
                                placeholder: ExamsVM.h-questions.proposed != "" ? ExamsVM.h-questions.proposed : "e.g. 30";
                                field: "questions";
                                error: ExamsVM.h-questions.error;
                                text <=> ExamsVM.new-questions;
                            }
                            forms := FormField {
                                horizontal-stretch: 1;
                                label: "Versions";
                                placeholder: ExamsVM.h-forms.proposed != "" ? ExamsVM.h-forms.proposed : "e.g. A, B";
                                field: "versions";
                                error: ExamsVM.h-forms.error;
                                text <=> ExamsVM.new-forms;
                            }
                            options := FormField {
                                horizontal-stretch: 1;
                                label: "Options per question";
                                placeholder: ExamsVM.h-options.proposed != "" ? ExamsVM.h-options.proposed : "the sheet's";
                                field: "options";
                                error: ExamsVM.h-options.error;
                                text <=> ExamsVM.new-options;
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-md;
                            roster := FormField {
                                horizontal-stretch: 1;
                                label: "Roster file";
                                placeholder: "roster.csv or .xlsx (recommended)";
                                target: "new-roster";
                                field: "roster";
                                error: ExamsVM.h-roster.error;
                                text <=> ExamsVM.new-roster;
                            }
                            clo := FormField {
                                horizontal-stretch: 1;
                                label: "CLO mapping file";
                                placeholder: "clo.csv (optional)";
                                target: "new-clo";
                                field: "clo";
                                error: ExamsVM.h-clo.error;
                                text <=> ExamsVM.new-clo;
                            }
                        }
                        HorizontalLayout {
                            alignment: start;
                            advanced := GhostButton {
                                text: ExamsVM.new-advanced ? "Advanced options ▾" : "Advanced options ▸";
                                accessible-label: "Advanced options";
                                accessible-description: "The sheet, term, student-number scheme, how marks are cancelled, second review, high stakes and the exam's folder";
                                accessible-expandable: true;
                                accessible-expanded: ExamsVM.new-advanced;
                                clicked => {
                                    ExamsVM.new-advanced = !ExamsVM.new-advanced;
                                }
                            }
                        }
                        // made only when opened: nothing of it exists before
                        if ExamsVM.new-advanced: VerticalLayout {
                            spacing: Theme.space-sm;
                            HorizontalLayout {
                                spacing: Theme.space-md;
                                FormField {
                                    horizontal-stretch: 1;
                                    changed has-focus => {
                                        root.made-focused = self.has-focus;
                                    }
                                    label: "Sheet template or spec file";
                                    placeholder: "iau-ccsit-v1, or your own sheet's spec file";
                                    target: "new-spec";
                                    field: "sheet";
                                    error: ExamsVM.h-sheet.error;
                                    text <=> ExamsVM.new-sheet;
                                }
                                FormField {
                                    horizontal-stretch: 1;
                                    changed has-focus => {
                                        root.made-focused = self.has-focus;
                                    }
                                    label: "Output folder";
                                    placeholder: ExamsVM.h-out.proposed != "" ? ExamsVM.h-out.proposed : "a new folder in the exams folder";
                                    target: "new-out";
                                    folder: true;
                                    field: "folder";
                                    error: ExamsVM.h-out.error;
                                    text <=> ExamsVM.new-out;
                                }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-md;
                                FormField {
                                    horizontal-stretch: 1;
                                    changed has-focus => {
                                        root.made-focused = self.has-focus;
                                    }
                                    label: "Term";
                                    placeholder: ExamsVM.h-term.proposed != "" ? ExamsVM.h-term.proposed : "e.g. 1447-2";
                                    mono: false;
                                    field: "term";
                                    error: ExamsVM.h-term.error;
                                    text <=> ExamsVM.new-term;
                                }
                                FormField {
                                    horizontal-stretch: 1;
                                    changed has-focus => {
                                        root.made-focused = self.has-focus;
                                    }
                                    label: "Student ID scheme";
                                    placeholder: ExamsVM.h-id-scheme.proposed != "" ? ExamsVM.h-id-scheme.proposed : "iau, or digits:9 for a 9-digit number";
                                    field: "id-scheme";
                                    error: ExamsVM.h-id-scheme.error;
                                    text <=> ExamsVM.new-id-scheme;
                                }
                            }
                            FormField {
                                changed has-focus => {
                                    root.made-focused = self.has-focus;
                                }
                                label: "Cancel mode";
                                // the printed sheet fixes how marks are cancelled: shown, never typed
                                enabled: !ExamsVM.cancel-locked;
                                placeholder: ExamsVM.h-cancel-mode.proposed != "" ? ExamsVM.h-cancel-mode.proposed : "the sheet's";
                                field: "cancel-mode";
                                error: ExamsVM.h-cancel-mode.error;
                                text <=> ExamsVM.new-cancel-mode;
                            }
                            // Second review: one of its choices, in plain words, never typed;
                            // the card's value is chosen until another is clicked
                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: "Second review";
                                    font-size: Theme.text-xs;
                                    font-weight: Theme.weight-semibold;
                                    color: Theme.ink-2;
                                    accessible-role: none;
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    SegmentGroup {
                                        accessible-role: AccessibleRole.groupbox;
                                        accessible-label: "Second review";
                                        accessible-description: ExamsVM.h-multi-review.proposed;
                                        for c in ExamsVM.review-choices: Segment {
                                            text: c.label;
                                            selected: (ExamsVM.new-multi-review != "" ? ExamsVM.new-multi-review : ExamsVM.review-value) == c.value;
                                            changed has-focus => {
                                                root.made-focused = self.has-focus;
                                            }
                                            clicked => {
                                                ExamsVM.new-multi-review = c.value;
                                                ExamsVM.form-changed("multi-review");
                                            }
                                        }
                                    }
                                }
                                Text {
                                    text: ExamsVM.h-multi-review.proposed;
                                    font-size: Theme.text-xs;
                                    color: Theme.ink-2;
                                    wrap: word-wrap;
                                    // the group's description carries it
                                    accessible-role: none;
                                }
                            }
                            Switch {
                                changed has-focus => {
                                    root.made-focused = self.has-focus;
                                }
                                label: "High-stakes exam";
                                description: ExamsVM.h-high-stakes.proposed;
                                checked <=> ExamsVM.new-high-stakes;
                                toggled => {
                                    ExamsVM.form-changed("high-stakes");
                                }
                            }
                        }
                    }
                    // ---- what is graded
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: start;
                        spacing: Theme.space-sm;
                        Text {
                            text: "What is graded";
                            font-size: Theme.text-sm;
                            font-weight: Theme.weight-semibold;
                            color: Theme.ink;
                        }
                        for a[i] in ExamsVM.card-asks: AskCard {
                            issue: a;
                            index: i;
                            focused(f) => {
                                root.made-focused = f;
                            }
                        }
                        if ExamsVM.card-notes.length > 0: HorizontalLayout {
                            alignment: start;
                            GhostButton {
                                changed has-focus => {
                                    root.made-focused = self.has-focus;
                                }
                                text: (ExamsVM.new-notes-open ? "Hide notes" : "Show notes") + " (" + ExamsVM.card-notes.length + ")";
                                // read as shown, the count included (voice control finds it by it)
                                accessible-label: self.text;
                                accessible-expandable: true;
                                accessible-expanded: ExamsVM.new-notes-open;
                                clicked => {
                                    ExamsVM.new-notes-open = !ExamsVM.new-notes-open;
                                }
                            }
                        }
                        if ExamsVM.new-notes-open: VerticalLayout {
                            spacing: Theme.space-xs;
                            for n in ExamsVM.card-notes: Text {
                                text: n.label + ": " + n.text;
                                font-size: Theme.text-xs;
                                color: Theme.ink-2;
                                wrap: word-wrap;
                            }
                        }
                        for v in ExamsVM.card-values: CardRow {
                            v: v;
                        }
                    }
                }
            }
            foot := HorizontalLayout {
                spacing: Theme.space-md;
                import := SecondaryButton {
                    text: "Import from Remark export…";
                    enabled: RemarkVM.can-new;
                    accessible-description: "Reads Remark's graded Excel exports: the key with exact points per version and the learning objectives, shown for your review before the card uses them";
                    clicked => {
                        RemarkVM.new-panel = true;
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: ExamsVM.new-block;
                    font-size: Theme.text-xs;
                    color: Theme.ink-2;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    accessible-role: none;
                }
                cancel := GhostButton {
                    text: "Cancel";
                    clicked => {
                        ExamsVM.new-open = false;
                    }
                }
                grade := PrimaryButton {
                    text: "Grade exam";
                    enabled: ExamsVM.new-block == "";
                    // why it waits, for a screen reader too
                    accessible-description: ExamsVM.new-block;
                    clicked => {
                        ExamsVM.create-exam();
                    }
                }
            }
        }
    }
}

// Import from Remark export on the New-exam form (§3.5, PAR-09): Remark's graded Excel exports
// read and shown for review; "Use this import" fills the form, which then grades with the key,
// its exact points per version and the learning objectives (imported, needs review).
component RemarkNewPanel inherits Rectangle {
    background: Theme.surface-raised;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: Theme.shadow-2-blur;
    drop-shadow-offset-y: Theme.shadow-2-offset;
    drop-shadow-color: Theme.shadow-2-color;
    in property <length> summary-h: 340px;
    property <bool> focus-inside: fields.has-focus || back.has-focus || use.has-focus || (RemarkVM.context == 1 && RemarkVM.refused && root.refusal-focused) || (RemarkVM.context == 1 && RemarkVM.has && (root.card-focused || root.aside-focused));
    // controls made and unmade with the import have the keyboard (each reset when made)
    property <bool> refusal-focused;
    property <bool> card-focused;
    property <bool> aside-focused;
    // An overlay: a press on its background must not reach the page underneath. A click on it
    // gives the panel the keyboard back (for Escape) unless a control inside has it.
    TouchArea {
        clicked => {
            if (!root.focus-inside) {
                fields.focus();
            }
        }
        scroll-event(event) => {
            return accept;
        }
    }
    FocusScope {
        // the fields inside keep focus when the bar's background is clicked
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                RemarkVM.new-panel = false;
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            padding: Theme.space-lg;
            spacing: Theme.space-sm;
            HorizontalLayout {
                spacing: Theme.space-md;
                Text {
                    text: "New exam · Import from Remark export";
                    font-size: Theme.text-md;
                    font-weight: Theme.weight-semibold;
                    color: Theme.ink;
                    vertical-alignment: center;
                }
                Text {
                    horizontal-stretch: 1;
                    text: "Remark's graded Excel exports (Advanced Grade reports): the key with exact points per version, the learning objectives and the key sheets Remark graded as students, for your review. Its .rmx and .aky files are never opened.";
                    font-size: Theme.text-xs;
                    color: Theme.ink-2;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
            fields := RemarkFields { }
            if RemarkVM.context == 1 && RemarkVM.refused: RemarkRefusal {
                init => {
                    root.refusal-focused = false;
                }
                changed has-focus => {
                    root.refusal-focused = self.has-focus;
                }
                message: RemarkVM.refusal;
                remedy: RemarkVM.remedy;
                suggestion: RemarkVM.suggestion;
                use-suggested => {
                    RemarkVM.use-suggested();
                }
            }
            if RemarkVM.context == 1 && RemarkVM.has: HorizontalLayout {
                height: root.summary-h;
                spacing: Theme.space-md;
                RemarkImportCard {
                    init => {
                        root.card-focused = false;
                    }
                    changed has-focus => {
                        root.card-focused = self.has-focus;
                    }
                    horizontal-stretch: 1;
                    compact: true;
                    elevated: false;
                }
                RemarkSideCard {
                    width: 360px;
                    elevated: false;
                }
            }
            if RemarkVM.context == 1 && RemarkVM.has: Text {
                text: RemarkVM.applies;
                font-size: Theme.text-xs;
                color: Theme.ink-2;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: Theme.space-md;
                alignment: end;
                back := GhostButton {
                    text: "Back to the form";
                    clicked => {
                        RemarkVM.new-panel = false;
                    }
                }
                if RemarkVM.context == 1 && RemarkVM.has: GhostButton {
                    init => {
                        root.aside-focused = false;
                    }
                    changed has-focus => {
                        root.aside-focused = self.has-focus;
                    }
                    text: "Put the import aside";
                    accessible-description: "Drops the import; the form is unchanged";
                    clicked => {
                        RemarkVM.discard();
                    }
                }
                use := PrimaryButton {
                    text: "Use this import";
                    enabled: RemarkVM.context == 1 && RemarkVM.has && RemarkVM.can-apply;
                    accessible-description: RemarkVM.applies;
                    clicked => {
                        RemarkVM.apply();
                    }
                }
            }
        }
    }
}

// Keyboard focus outline of the exams table: the selected row of the focused table.
component RowFocus inherits Rectangle {
    border-width: 2px;
    border-radius: 2px;
    border-color: Theme.focus;
}

export component ExamsScreen inherits Rectangle {
    in property <length> win-w: 1440px;
    in property <length> win-h: 900px;
    // the table and the 360 px drawer fit side by side from about 1420 px; below, the drawer
    // overlays the table's right edge (shadow-2), as a drawer does
    property <bool> narrow: root.win-w < 1420px;
    property <bool> short: root.win-h < 880px;
    property <int> search-request: ExamsVM.search-request;
    changed search-request => {
        search.focus();
    }
    VerticalLayout {
        TopBar {
            HorizontalLayout {
                spacing: Theme.space-lg;
                Text {
                    text: "Mizan";
                    font-size: Theme.text-lg;
                    font-weight: Theme.weight-semibold;
                    color: Theme.ink;
                    vertical-alignment: center;
                }
                // the term of the exams listed (none in an empty folder: no empty tag)
                if ExamsVM.term-label != "": Centered {
                    Tag {
                        text: ExamsVM.term-label;
                        mono: false;
                    }
                }
            }
            HorizontalLayout {
                spacing: Theme.space-md;
                Centered {
                    search := SearchField {
                        placeholder: "Search exams and courses";
                        key-hint: "Ctrl+K";
                        width: root.narrow ? 220px : 280px;
                        text <=> ExamsVM.search-text;
                        accepted(t) => {
                            ExamsVM.search(t);
                        }
                    }
                }
                // another exams folder (or one exam's folder), and this one read again
                if ExamsVM.can-open-workspace && App.can-browse: Centered {
                    SecondaryButton {
                        text: "Open folder…";
                        key-hint: "Ctrl+O";
                        clicked => {
                            App.open-workspace();
                        }
                    }
                }
                if ExamsVM.can-open-workspace: Centered {
                    IconButton {
                        icon: Icons.refresh;
                        label: "Refresh the exams list (F5)";
                        clicked => {
                            App.refresh();
                        }
                    }
                }
                Centered {
                    PrimaryButton {
                        text: "New exam";
                        icon: Icons.plus;
                        key-hint: "Ctrl+N";
                        clicked => {
                            App.request("New exam");
                        }
                    }
                }
                Centered {
                    ThemeToggle { }
                }
                Rectangle {
                    width: 1px;
                    background: Theme.border;
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: App.user-name;
                        font-size: Theme.text-sm;
                        font-weight: Theme.weight-semibold;
                        color: Theme.ink;
                        horizontal-alignment: right;
                    }
                    // a role only when the backend knows one (the real core has no roles)
                    if App.user-role != "": Text {
                        text: App.user-role;
                        font-size: Theme.text-2xs;
                        color: Theme.ink-2;
                        horizontal-alignment: right;
                    }
                }
                Centered {
                    Avatar {
                        initials: App.user-initials;
                    }
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
        HorizontalLayout {
            VerticalLayout {
                horizontal-stretch: 1;
                padding: Theme.space-xl;
                spacing: Theme.space-lg;
                VerticalLayout {
                    spacing: Theme.space-sm;
                    HorizontalLayout {
                        Text {
                            text: "Exams";
                            font-size: Theme.text-xl;
                            font-weight: Theme.weight-semibold;
                            color: Theme.ink;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: ExamsVM.term-label;
                            font-size: Theme.text-xs;
                            color: Theme.ink-2;
                            vertical-alignment: center;
                        }
                    }
                    GirihDivider { }
                }
                HorizontalLayout {
                    spacing: Theme.space-sm;
                    alignment: start;
                    for f[i] in ExamsVM.filters: Chip {
                        text: f.label;
                        count: f.count;
                        selected: i == ExamsVM.filter;
                        clicked => {
                            ExamsVM.set-filter(i);
                        }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.space-md;
                    StatTile {
                        horizontal-stretch: 1;
                        label: "SHEETS SCANNED THIS WEEK";
                        value: ExamsVM.sheets-week;
                        caption: ExamsVM.sheets-today;
                        caption-tone: ExamsVM.sheets-today-tone;
                    }
                    StatTile {
                        horizontal-stretch: 1;
                        label: "OPEN EXCEPTIONS";
                        value: ExamsVM.open-exceptions;
                        caption: ExamsVM.open-errors;
                        caption-tone: ExamsVM.open-errors-tone;
                    }
                    StatTile {
                        horizontal-stretch: 1;
                        label: "MEDIAN REVIEW TIME";
                        value: ExamsVM.median-review;
                        unit: "s / item";
                        caption: ExamsVM.median-caption;
                    }
                    StatTile {
                        horizontal-stretch: 1;
                        label: "THROUGHPUT";
                        value: ExamsVM.throughput;
                        unit: "pages / s";
                        caption: ExamsVM.throughput-caption;
                    }
                }
                Card {
                    inset: 0;
                    vertical-stretch: 1;
                    VerticalLayout {
                        TableRow {
                            header: true;
                            TableHeaderCell {
                                text: "Course";
                                horizontal-stretch: 1;
                                min-width: 220px;
                            }
                            TableHeaderCell {
                                text: "Assessment";
                                width: 104px;
                            }
                            TableHeaderCell {
                                text: "Date";
                                width: 116px;
                            }
                            TableHeaderCell {
                                text: "Forms";
                                width: 100px;
                            }
                            TableHeaderCell {
                                text: "Sheets";
                                width: 124px;
                            }
                            TableHeaderCell {
                                text: "Exceptions";
                                width: 148px;
                            }
                            TableHeaderCell {
                                text: "Status";
                                width: 120px;
                            }
                        }
                        // One tab stop for the table: ↑ / ↓ move the selection, Enter or Space opens
                        // the drawer (DESIGN §9.1); the focused row shows the gold outline.
                        table-keys := FocusScope {
                            vertical-stretch: ExamsVM.rows.length == 0 ? 0 : 1;
                            key-pressed(event) => {
                                if (event.modifiers.control || event.modifiers.alt) {
                                    return reject;
                                }
                                if (event.text == Key.DownArrow) {
                                    ExamsVM.move(1);
                                    return accept;
                                }
                                if (event.text == Key.UpArrow) {
                                    ExamsVM.move(-1);
                                    return accept;
                                }
                                if ((event.text == Key.Return || event.text == " ") && ExamsVM.selected >= 0) {
                                    ExamsVM.select(ExamsVM.rows[ExamsVM.selected].id);
                                    return accept;
                                }
                                return reject;
                            }
                            ListView {
                                for row[i] in ExamsVM.rows: Rectangle {
                                    height: 56px;
                                    ExamTableRow {
                                        width: parent.width;
                                        height: parent.height;
                                        data: row;
                                        key: row.id;
                                        selected: i == ExamsVM.selected;
                                        picked(id) => {
                                            ExamsVM.select(id);
                                            table-keys.focus();
                                        }
                                    }
                                    if table-keys.has-focus && i == ExamsVM.selected: RowFocus {
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                }
                            }
                        }
                        // an empty folder: what goes here and how it gets here (the New-exam
                        // form floats over this, so its buttons are never shown twice)
                        if ExamsVM.rows.length == 0 && ExamsVM.filters[0].count == 0 && !ExamsVM.new-open: EmptyState {
                            vertical-stretch: 1;
                            title: "No exams in this folder yet";
                            text: ExamsVM.can-open-workspace && App.can-browse
                                ? "Each exam graded into this folder is listed here. Grade one from its scans with New exam, open the folder your exams are in, or start from Remark's graded Excel exports."
                                : "Each exam graded into this folder is listed here. Grade one from its scans with New exam, or start from Remark's graded Excel exports.";
                            PrimaryButton {
                                text: "New exam…";
                                icon: Icons.plus;
                                clicked => {
                                    App.request("New exam");
                                }
                            }
                            if ExamsVM.can-open-workspace && App.can-browse: SecondaryButton {
                                text: "Open another folder…";
                                accessible-description: "Opens the folder dialog: the folder your exams are in, or the folder of one exam";
                                clicked => {
                                    App.open-workspace();
                                }
                            }
                            if ExamsVM.can-create && RemarkVM.can-new: GhostButton {
                                text: "Import from Remark export…";
                                accessible-description: "Opens the New-exam form on Remark's graded Excel exports: the key with exact points per version and the learning objectives, shown for your review before the form uses them";
                                clicked => {
                                    RemarkVM.new-panel = true;
                                    App.request("New exam");
                                }
                            }
                        }
                        // exams the status filter or the search hides
                        if ExamsVM.rows.length == 0 && ExamsVM.filters[0].count > 0: EmptyState {
                            vertical-stretch: 1;
                            title: ExamsVM.search-applied != "" ? "No exams match \"" + ExamsVM.search-applied + "\"" : "No exams with this status";
                            GhostButton {
                                text: "Show all exams";
                                clicked => {
                                    ExamsVM.search-text = "";
                                    ExamsVM.search("");
                                    ExamsVM.set-filter(0);
                                }
                            }
                        }
                    }
                }
            }
            if ExamsVM.drawer-open && !root.narrow: Drawer {
                short: root.short;
            }
        }
        if ExamsVM.drawer-open && root.narrow: Drawer {
            x: parent.width - self.width;
            y: 0;
            height: parent.height;
            short: root.short;
        }
        }
        StatusBar {
            StatusText {
                text: App.workspace;
                mono: true;
                horizontal-stretch: 1;
                overflow: elide;
            }
            MessageText {
                text: App.message;
                tone: App.message-tone;
            }
            StatusText {
                text: App.engine;
                mono: true;
            }
        }
    }
    // the form floats over the dashboard, so opening it never pushes the status bar out of a
    // 1280 × 800 window
    if ExamsVM.new-open && !RemarkVM.new-panel: NewExamBar {
        x: (root.width - self.width) / 2;
        y: Theme.top-bar-height + Theme.space-sm;
        width: min(root.width - 2 * Theme.space-lg, 1240px);
        height: self.preferred-height;
        // the status bar stays in view: it says why a click did nothing
        max-h: root.height - Theme.top-bar-height - Theme.status-bar-height - 2 * Theme.space-sm;
    }
    if ExamsVM.new-open && RemarkVM.new-panel: RemarkNewPanel {
        x: (root.width - self.width) / 2;
        y: Theme.top-bar-height + Theme.space-sm;
        width: min(root.width - 2 * Theme.space-lg, 1120px);
        height: self.preferred-height;
        summary-h: min(400px, root.height - Theme.top-bar-height - 330px);
    }
}
