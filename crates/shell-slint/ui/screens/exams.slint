// Exams dashboard (DESIGN §9.1, concept exams-dashboard.png).

import {
    Theme, Tone, Severity, Card, StatTile, GirihDivider, TopBar, StatusBar, SearchField, PrimaryButton,
    SecondaryButton, GhostButton, IconButton, Chip, StatusPill, Tag, ProgressBar, TableRow,
    TableHeaderCell, TableCell, SeverityGlyph,
} from "../theme.slint";
import { App, ExamsVM, ExamRow, Page, RemarkVM } from "../state.slint";
import { RemarkFields, RemarkRefusal, RemarkImportCard, RemarkSideCard } from "remark.slint";
import {
    Icons, ThemeToggle, Centered, KVLine, SectionLabel, StatusText, SeverityStack, SeverityCount,
    CoverageRing, Avatar, MessageText, TextField,
} from "../widgets.slint";
import { ListView } from "std-widgets.slint";

component ExamTableRow inherits TableRow {
    in property <ExamRow> data;
    row-height: 56px;
    accessible-label: root.data.label;
    Rectangle {
        horizontal-stretch: 1;
        min-width: 220px;
        VerticalLayout {
            padding-left: Theme.space-md;
            padding-right: Theme.space-sm;
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: Theme.space-sm;
                Text {
                    text: root.data.code;
                    font-family: Theme.font-mono;
                    font-size: Theme.text-sm;
                    font-weight: Theme.weight-semibold;
                    color: Theme.primary;
                    vertical-alignment: center;
                }
                Text {
                    text: root.data.title;
                    font-size: Theme.text-sm;
                    font-weight: Theme.weight-medium;
                    color: Theme.ink;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
            // Arabic title: its own run in the Arabic face, shaped RTL, left-aligned with the column
            Text {
                text: root.data.title-ar;
                font-family: Theme.font-arabic;
                font-size: Theme.text-xs;
                color: Theme.ink-2;
                horizontal-alignment: left;
                overflow: elide;
            }
        }
    }
    TableCell {
        width: 104px;
        text: root.data.assessment;
        tint: Theme.ink;
    }
    TableCell {
        width: 116px;
        text: root.data.date;
        secondary: root.data.date-hijri;
        mono: true;
    }
    Rectangle {
        width: 100px;
        HorizontalLayout {
            padding-left: Theme.space-md;
            spacing: 3px;
            alignment: start;
            for f in root.data.forms: Centered {
                Tag {
                    text: f;
                }
            }
        }
    }
    Rectangle {
        width: 124px;
        VerticalLayout {
            padding-left: Theme.space-md;
            padding-right: Theme.space-md;
            alignment: center;
            spacing: 5px;
            HorizontalLayout {
                spacing: 2px;
                Text {
                    text: root.data.scanned;
                    font-family: Theme.font-mono;
                    font-size: Theme.text-sm;
                    font-weight: Theme.weight-medium;
                    color: Theme.ink;
                }
                Text {
                    text: " / " + root.data.expected;
                    font-family: Theme.font-mono;
                    font-size: Theme.text-xs;
                    color: Theme.ink-2;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
            ProgressBar {
                value: root.data.progress;
                tone: root.data.progress-tone;
                thickness: 4px;
            }
        }
    }
    Rectangle {
        width: 148px;
        VerticalLayout {
            padding-left: Theme.space-md;
            padding-right: Theme.space-md;
            alignment: center;
            spacing: 5px;
            if root.data.error + root.data.blocker + root.data.warn + root.data.info == 0: Text {
                text: "None";
                font-size: Theme.text-sm;
                color: Theme.ink-3;
            }
            if root.data.error + root.data.blocker + root.data.warn + root.data.info > 0: SeverityStack {
                blocker: root.data.blocker;
                error: root.data.error;
                warn: root.data.warn;
                info: root.data.info;
            }
            if root.data.error + root.data.blocker + root.data.warn + root.data.info > 0: HorizontalLayout {
                spacing: Theme.space-sm;
                alignment: start;
                if root.data.error + root.data.blocker > 0: SeverityCount {
                    severity: Severity.error;
                    count: root.data.error + root.data.blocker;
                }
                if root.data.warn > 0: SeverityCount {
                    severity: Severity.warn;
                    count: root.data.warn;
                }
                if root.data.info > 0: SeverityCount {
                    severity: Severity.info;
                    count: root.data.info;
                }
            }
        }
    }
    Rectangle {
        width: 120px;
        HorizontalLayout {
            padding-left: Theme.space-md;
            alignment: start;
            Centered {
                StatusPill {
                    text: root.data.status;
                    tone: root.data.status-tone;
                }
            }
        }
    }
}

component Drawer inherits Rectangle {
    // tighter rhythm below 880 px so the drawer fits 800 px windows (DESIGN §9)
    in property <bool> short;
    width: Theme.drawer-width;
    background: Theme.surface;
    drop-shadow-blur: Theme.shadow-2-blur;
    drop-shadow-offset-x: -2px;
    drop-shadow-color: Theme.shadow-2-color;
    // Below 1420 px the drawer lies over the table: a press on its background must not select
    // the row underneath.
    TouchArea {
        scroll-event(event) => {
            return accept;
        }
    }
    Rectangle {
        x: 0;
        width: 1px;
        background: Theme.border;
    }
    VerticalLayout {
        // header
        VerticalLayout {
            padding: Theme.space-xl;
            padding-bottom: Theme.space-lg;
            spacing: Theme.space-xs;
            HorizontalLayout {
                spacing: Theme.space-sm;
                Text {
                    text: ExamsVM.drawer.code;
                    font-family: Theme.font-mono;
                    font-size: Theme.text-xl;
                    font-weight: Theme.weight-semibold;
                    color: Theme.primary;
                    vertical-alignment: center;
                }
                Centered {
                    Tag {
                        text: ExamsVM.drawer.assessment;
                        mono: false;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                IconButton {
                    icon: Icons.close;
                    label: "Close details (Esc)";
                    clicked => {
                        ExamsVM.close-drawer();
                    }
                }
            }
            Text {
                text: ExamsVM.drawer.title;
                font-size: Theme.text-md;
                font-weight: Theme.weight-medium;
                color: Theme.ink;
            }
            Text {
                text: ExamsVM.drawer.title-ar;
                font-family: Theme.font-arabic;
                font-size: Theme.text-sm;
                color: Theme.ink-2;
                horizontal-alignment: left;
            }
            HorizontalLayout {
                spacing: Theme.space-sm;
                Text {
                    text: ExamsVM.drawer.term;
                    font-size: Theme.text-xs;
                    color: Theme.ink-3;
                    vertical-alignment: center;
                }
                Text {
                    text: ExamsVM.drawer.term-ar;
                    font-family: Theme.font-arabic;
                    font-size: Theme.text-xs;
                    color: Theme.ink-3;
                    vertical-alignment: center;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.border;
        }
        VerticalLayout {
            padding: Theme.space-xl;
            padding-top: root.short ? Theme.space-lg : Theme.space-xl;
            spacing: root.short ? Theme.space-sm + 2px : Theme.space-lg;
            // status call-out
            Rectangle {
                border-radius: Theme.radius-lg;
                background: Theme.tone-soft(ExamsVM.drawer.callout-tone);
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-sm;
                    HorizontalLayout {
                        spacing: Theme.space-sm;
                        Centered {
                            StatusPill {
                                text: ExamsVM.drawer.status;
                                tone: ExamsVM.drawer.status-tone;
                            }
                        }
                        Text {
                            text: ExamsVM.drawer.callout-title;
                            font-size: Theme.text-sm;
                            font-weight: Theme.weight-semibold;
                            color: Theme.tone-fg(ExamsVM.drawer.callout-tone);
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    Text {
                        text: ExamsVM.drawer.callout-text;
                        font-size: Theme.text-sm;
                        color: Theme.ink;
                        wrap: word-wrap;
                    }
                    if ExamsVM.drawer.can-review: PrimaryButton {
                        text: ExamsVM.drawer.review-label;
                        icon: Icons.review;
                        key-hint: "Ctrl+4";
                        clicked => {
                            ExamsVM.open(Page.review);
                        }
                    }
                }
            }
            SectionLabel {
                text: "CONFIGURATION";
            }
            HorizontalLayout {
                spacing: Theme.space-sm;
                Centered {
                    Image {
                        source: Icons.check;
                        width: 16px;
                        height: 16px;
                        colorize: Theme.success;
                    }
                }
                Text {
                    text: "Answer key";
                    font-size: Theme.text-sm;
                    color: Theme.ink;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Centered {
                    Tag {
                        text: ExamsVM.drawer.key-status;
                        tone: Tone.primary;
                    }
                }
            }
            HorizontalLayout {
                spacing: Theme.space-sm;
                Centered {
                    Image {
                        source: Icons.outcomes;
                        width: 16px;
                        height: 16px;
                        colorize: Theme.ink-2;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: "CLO mapping";
                        font-size: Theme.text-sm;
                        color: Theme.ink;
                    }
                    Text {
                        text: ExamsVM.drawer.mapped + " of " + ExamsVM.drawer.total + " items " + ExamsVM.drawer.mapped-word;
                        font-size: Theme.text-xs;
                        color: Theme.ink-2;
                    }
                }
                CoverageRing {
                    value: ExamsVM.drawer.total > 0 ? ExamsVM.drawer.mapped / ExamsVM.drawer.total : 0;
                    text: ExamsVM.drawer.total > 0 ? round(100 * ExamsVM.drawer.mapped / ExamsVM.drawer.total) + "%" : "–";
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.border;
            }
            SectionLabel {
                text: "LOGISTICS";
            }
            KVLine {
                label: "Roster";
                value: ExamsVM.drawer.roster;
            }
            KVLine {
                label: "Sections";
                value: ExamsVM.drawer.sections;
            }
            KVLine {
                label: "Last scan";
                value: ExamsVM.drawer.last-scan;
            }
            KVLine {
                label: "Batch ID";
                value: ExamsVM.drawer.batch-id;
                mono: true;
            }
            Rectangle {
                vertical-stretch: 1;
            }
            HorizontalLayout {
                spacing: Theme.space-sm;
                SecondaryButton {
                    text: "Open results";
                    horizontal-stretch: 1;
                    clicked => {
                        ExamsVM.open(Page.results);
                    }
                }
                SecondaryButton {
                    text: "Exam setup";
                    horizontal-stretch: 1;
                    clicked => {
                        ExamsVM.open(Page.setup);
                    }
                }
            }
            GhostButton {
                text: "Scan and recognise";
                icon: Icons.scan;
                clicked => {
                    ExamsVM.open(Page.scan);
                }
            }
        }
    }
}

// One labelled field of the New-exam form: the visible label above the field (the field's
// accessible label is the same text).
component FormField inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <bool> mono: true;
    in-out property <string> text;
    callback accepted(string);
    forward-focus: field;
    spacing: 2px;
    Text {
        text: root.label;
        font-size: Theme.text-xs;
        font-weight: Theme.weight-semibold;
        color: Theme.ink-2;
        accessible-role: none;
    }
    field := TextField {
        label: root.label;
        placeholder: root.placeholder;
        text <=> root.text;
        mono: root.mono;
        accepted(v) => {
            root.accepted(v);
        }
    }
}

// The New-exam form (CR-04): the scans, the sheet and the question count, with the key,
// roster and CLO files. Rust validates it with the rules of `omr grade` and grades it in the
// background into a new folder of the workspace; the Scan screen follows the run.
component NewExamBar inherits Rectangle {
    background: Theme.surface-raised;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: Theme.shadow-2-blur;
    drop-shadow-offset-y: Theme.shadow-2-offset;
    drop-shadow-color: Theme.shadow-2-color;
    property <bool> ready: ExamsVM.can-create && ExamsVM.new-scans != "" && ExamsVM.new-questions != "";
    init => {
        scans.focus();
    }
    // An overlay: a press on its background must not reach the page underneath.
    TouchArea {
        scroll-event(event) => {
            return accept;
        }
    }
    FocusScope {
        // the fields inside keep focus when the bar's background is clicked
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                ExamsVM.new-open = false;
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            padding: Theme.space-lg;
            spacing: Theme.space-sm;
            HorizontalLayout {
                spacing: Theme.space-md;
                Text {
                    text: "New exam";
                    font-size: Theme.text-md;
                    font-weight: Theme.weight-semibold;
                    color: Theme.ink;
                    vertical-alignment: center;
                }
                Text {
                    horizontal-stretch: 1;
                    text: ExamsVM.new-note;
                    font-size: Theme.text-xs;
                    color: Theme.ink-2;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
            scans := FormField {
                label: "Scan files or folders";
                placeholder: "A folder or files of scans (PDF, TIFF, JPEG, PNG); separate several with ;";
                text <=> ExamsVM.new-scans;
            }
            HorizontalLayout {
                spacing: Theme.space-md;
                FormField {
                    horizontal-stretch: 2;
                    label: "Exam title";
                    placeholder: "e.g. Midterm 1";
                    mono: false;
                    text <=> ExamsVM.new-title;
                }
                FormField {
                    horizontal-stretch: 1;
                    label: "Course code";
                    placeholder: "e.g. CS 211";
                    mono: false;
                    text <=> ExamsVM.new-course;
                }
            }
            HorizontalLayout {
                spacing: Theme.space-md;
                FormField {
                    horizontal-stretch: 3;
                    label: "Sheet template or spec file";
                    placeholder: "iau-ccsit-v1, or the spec file of your own sheet";
                    text <=> ExamsVM.new-sheet;
                }
                FormField {
                    horizontal-stretch: 1;
                    label: "Number of questions";
                    placeholder: "e.g. 30";
                    text <=> ExamsVM.new-questions;
                }
                FormField {
                    horizontal-stretch: 1;
                    label: "Options per question";
                    placeholder: "sheet's";
                    text <=> ExamsVM.new-options;
                }
                FormField {
                    horizontal-stretch: 1;
                    label: "Form letters";
                    placeholder: "from key";
                    text <=> ExamsVM.new-forms;
                }
            }
            // the key, its points and the learning objectives from a Remark import (§3.5)
            if RemarkVM.new-using: Rectangle {
                background: Theme.accent-soft;
                border-radius: Theme.radius-md;
                accessible-role: AccessibleRole.text;
                accessible-label: RemarkVM.new-using-text;
                height: using.preferred-height;
                using := HorizontalLayout {
                    padding-left: Theme.space-md;
                    padding-right: Theme.space-sm;
                    padding-top: Theme.space-xs;
                    padding-bottom: Theme.space-xs;
                    spacing: Theme.space-md;
                    Text {
                        horizontal-stretch: 1;
                        text: RemarkVM.new-using-text;
                        font-size: Theme.text-xs;
                        color: Theme.ink;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        accessible-role: none;
                    }
                    Centered {
                        GhostButton {
                            text: "Clear the Remark import";
                            accessible-description: "The form no longer uses the import: give a key file, key sheets or no key";
                            clicked => {
                                RemarkVM.clear-new();
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: Theme.space-md;
                FormField {
                    horizontal-stretch: 1;
                    label: "Answer key file";
                    placeholder: "key.csv; blank: infer a provisional key";
                    text <=> ExamsVM.new-key;
                }
                FormField {
                    horizontal-stretch: 1;
                    label: "Roster file";
                    placeholder: "roster.csv or .xlsx (optional)";
                    text <=> ExamsVM.new-roster;
                }
                FormField {
                    horizontal-stretch: 1;
                    label: "CLO mapping file";
                    placeholder: "clo.csv (optional)";
                    text <=> ExamsVM.new-clo;
                }
            }
            HorizontalLayout {
                spacing: Theme.space-md;
                FormField {
                    horizontal-stretch: 1;
                    label: "Key sheets";
                    placeholder: "the instructor's filled answer sheets, ; between several (optional; confirmed in Setup)";
                    text <=> ExamsVM.new-key-sheets;
                }
            }
            HorizontalLayout {
                spacing: Theme.space-md;
                SecondaryButton {
                    text: "Import from Remark export…";
                    enabled: RemarkVM.can-new;
                    accessible-description: "Reads Remark's graded Excel exports: the key with exact points per version and the learning objectives, shown for your review before the form uses them";
                    clicked => {
                        RemarkVM.new-panel = true;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                GhostButton {
                    text: "Cancel";
                    clicked => {
                        ExamsVM.new-open = false;
                    }
                }
                PrimaryButton {
                    text: "Grade exam";
                    enabled: root.ready;
                    clicked => {
                        ExamsVM.create-exam();
                    }
                }
            }
        }
    }
}

// Import from Remark export on the New-exam form (§3.5, PAR-09): Remark's graded Excel exports
// read and shown for review; "Use this import" fills the form, which then grades with the key,
// its exact points per version and the learning objectives (imported, needs review).
component RemarkNewPanel inherits Rectangle {
    background: Theme.surface-raised;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: Theme.shadow-2-blur;
    drop-shadow-offset-y: Theme.shadow-2-offset;
    drop-shadow-color: Theme.shadow-2-color;
    in property <length> summary-h: 340px;
    // An overlay: a press on its background must not reach the page underneath.
    TouchArea {
        scroll-event(event) => {
            return accept;
        }
    }
    FocusScope {
        // the fields inside keep focus when the bar's background is clicked
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                RemarkVM.new-panel = false;
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            padding: Theme.space-lg;
            spacing: Theme.space-sm;
            HorizontalLayout {
                spacing: Theme.space-md;
                Text {
                    text: "New exam · Import from Remark export";
                    font-size: Theme.text-md;
                    font-weight: Theme.weight-semibold;
                    color: Theme.ink;
                    vertical-alignment: center;
                }
                Text {
                    horizontal-stretch: 1;
                    text: "Remark's graded Excel exports (Advanced Grade reports): the key with exact points per version, the learning objectives and the key sheets Remark graded as students, for your review. Its .rmx and .aky files are never opened (spec §3.5).";
                    font-size: Theme.text-xs;
                    color: Theme.ink-2;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
            RemarkFields { }
            if RemarkVM.context == 1 && RemarkVM.refused: RemarkRefusal {
                message: RemarkVM.refusal;
                remedy: RemarkVM.remedy;
                suggestion: RemarkVM.suggestion;
                use-suggested => {
                    RemarkVM.use-suggested();
                }
            }
            if RemarkVM.context == 1 && RemarkVM.has: HorizontalLayout {
                height: root.summary-h;
                spacing: Theme.space-md;
                RemarkImportCard {
                    horizontal-stretch: 1;
                    compact: true;
                    elevated: false;
                }
                RemarkSideCard {
                    width: 360px;
                    elevated: false;
                }
            }
            if RemarkVM.context == 1 && RemarkVM.has: Text {
                text: RemarkVM.applies;
                font-size: Theme.text-xs;
                color: Theme.ink-2;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: Theme.space-md;
                alignment: end;
                GhostButton {
                    text: "Back to the form";
                    clicked => {
                        RemarkVM.new-panel = false;
                    }
                }
                if RemarkVM.context == 1 && RemarkVM.has: GhostButton {
                    text: "Put the import aside";
                    accessible-description: "Drops the import; the form is unchanged";
                    clicked => {
                        RemarkVM.discard();
                    }
                }
                PrimaryButton {
                    text: "Use this import";
                    enabled: RemarkVM.context == 1 && RemarkVM.has && RemarkVM.can-apply;
                    accessible-description: RemarkVM.applies;
                    clicked => {
                        RemarkVM.apply();
                    }
                }
            }
        }
    }
}

// Keyboard focus outline of the exams table: the selected row of the focused table.
component RowFocus inherits Rectangle {
    border-width: 2px;
    border-radius: 2px;
    border-color: Theme.focus;
}

export component ExamsScreen inherits Rectangle {
    in property <length> win-w: 1440px;
    in property <length> win-h: 900px;
    // the table and the 360 px drawer fit side by side from about 1420 px; below, the drawer
    // overlays the table's right edge (shadow-2), as a drawer does
    property <bool> narrow: root.win-w < 1420px;
    property <bool> short: root.win-h < 880px;
    property <int> search-request: ExamsVM.search-request;
    changed search-request => {
        search.focus();
    }
    VerticalLayout {
        TopBar {
            HorizontalLayout {
                spacing: Theme.space-lg;
                Text {
                    text: "Mizan";
                    font-size: Theme.text-lg;
                    font-weight: Theme.weight-semibold;
                    color: Theme.ink;
                    vertical-alignment: center;
                }
                Centered {
                    Tag {
                        text: ExamsVM.term-label;
                        mono: false;
                    }
                }
            }
            HorizontalLayout {
                spacing: Theme.space-md;
                Centered {
                    search := SearchField {
                        placeholder: "Search exams and courses";
                        key-hint: "Ctrl+K";
                        width: root.narrow ? 220px : 280px;
                        accepted(t) => {
                            App.request("Search for \"" + t + "\"");
                        }
                    }
                }
                Centered {
                    PrimaryButton {
                        text: "New exam";
                        icon: Icons.plus;
                        key-hint: "Ctrl+N";
                        clicked => {
                            App.request("New exam");
                        }
                    }
                }
                Centered {
                    ThemeToggle { }
                }
                Rectangle {
                    width: 1px;
                    background: Theme.border;
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: App.user-name;
                        font-size: Theme.text-sm;
                        font-weight: Theme.weight-semibold;
                        color: Theme.ink;
                        horizontal-alignment: right;
                    }
                    Text {
                        text: App.user-role;
                        font-size: Theme.text-2xs;
                        color: Theme.ink-2;
                        horizontal-alignment: right;
                    }
                }
                Centered {
                    Avatar {
                        initials: App.user-initials;
                    }
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
        HorizontalLayout {
            VerticalLayout {
                horizontal-stretch: 1;
                padding: Theme.space-xl;
                spacing: Theme.space-lg;
                VerticalLayout {
                    spacing: Theme.space-sm;
                    HorizontalLayout {
                        Text {
                            text: "Exams";
                            font-size: Theme.text-xl;
                            font-weight: Theme.weight-semibold;
                            color: Theme.ink;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: ExamsVM.term-label;
                            font-size: Theme.text-xs;
                            color: Theme.ink-2;
                            vertical-alignment: center;
                        }
                    }
                    GirihDivider { }
                }
                HorizontalLayout {
                    spacing: Theme.space-sm;
                    alignment: start;
                    for f[i] in ExamsVM.filters: Chip {
                        text: f.label;
                        count: f.count;
                        selected: i == ExamsVM.filter;
                        clicked => {
                            ExamsVM.set-filter(i);
                        }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.space-md;
                    StatTile {
                        horizontal-stretch: 1;
                        label: "SHEETS SCANNED THIS WEEK";
                        value: ExamsVM.sheets-week;
                        caption: ExamsVM.sheets-today;
                        caption-tone: Tone.success;
                    }
                    StatTile {
                        horizontal-stretch: 1;
                        label: "OPEN EXCEPTIONS";
                        value: ExamsVM.open-exceptions;
                        caption: ExamsVM.open-errors;
                        caption-tone: Tone.error;
                    }
                    StatTile {
                        horizontal-stretch: 1;
                        label: "MEDIAN REVIEW TIME";
                        value: ExamsVM.median-review;
                        unit: "s / item";
                        caption: ExamsVM.median-caption;
                    }
                    StatTile {
                        horizontal-stretch: 1;
                        label: "THROUGHPUT";
                        value: ExamsVM.throughput;
                        unit: "pages / s";
                        caption: "Floor 40 pages / s";
                    }
                }
                Card {
                    inset: 0;
                    vertical-stretch: 1;
                    VerticalLayout {
                        TableRow {
                            header: true;
                            TableHeaderCell {
                                text: "Course";
                                horizontal-stretch: 1;
                                min-width: 220px;
                            }
                            TableHeaderCell {
                                text: "Assessment";
                                width: 104px;
                            }
                            TableHeaderCell {
                                text: "Date";
                                width: 116px;
                            }
                            TableHeaderCell {
                                text: "Forms";
                                width: 100px;
                            }
                            TableHeaderCell {
                                text: "Sheets";
                                width: 124px;
                            }
                            TableHeaderCell {
                                text: "Exceptions";
                                width: 148px;
                            }
                            TableHeaderCell {
                                text: "Status";
                                width: 120px;
                            }
                        }
                        // One tab stop for the table: ↑ / ↓ move the selection, Enter or Space opens
                        // the drawer (DESIGN §9.1); the focused row shows the gold outline.
                        table-keys := FocusScope {
                            vertical-stretch: 1;
                            key-pressed(event) => {
                                if (event.modifiers.control || event.modifiers.alt) {
                                    return reject;
                                }
                                if (event.text == Key.DownArrow) {
                                    ExamsVM.move(1);
                                    return accept;
                                }
                                if (event.text == Key.UpArrow) {
                                    ExamsVM.move(-1);
                                    return accept;
                                }
                                if ((event.text == Key.Return || event.text == " ") && ExamsVM.selected >= 0) {
                                    ExamsVM.select(ExamsVM.rows[ExamsVM.selected].id);
                                    return accept;
                                }
                                return reject;
                            }
                            ListView {
                                for row[i] in ExamsVM.rows: Rectangle {
                                    height: 56px;
                                    ExamTableRow {
                                        width: parent.width;
                                        height: parent.height;
                                        data: row;
                                        key: row.id;
                                        selected: i == ExamsVM.selected;
                                        picked(id) => {
                                            ExamsVM.select(id);
                                            table-keys.focus();
                                        }
                                    }
                                    if table-keys.has-focus && i == ExamsVM.selected: RowFocus {
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if ExamsVM.drawer-open && !root.narrow: Drawer {
                short: root.short;
            }
        }
        if ExamsVM.drawer-open && root.narrow: Drawer {
            x: parent.width - self.width;
            y: 0;
            height: parent.height;
            short: root.short;
        }
        }
        StatusBar {
            Centered {
                StatusPill {
                    text: "Project saved";
                    tone: Tone.success;
                }
            }
            StatusText {
                text: App.workspace;
                mono: true;
                horizontal-stretch: 1;
                overflow: elide;
            }
            MessageText {
                text: App.message;
                tone: App.message-tone;
            }
            StatusText {
                text: App.engine;
                mono: true;
            }
        }
    }
    // the form floats over the dashboard, so opening it never pushes the status bar out of a
    // 1280 × 800 window
    if ExamsVM.new-open && !RemarkVM.new-panel: NewExamBar {
        x: (root.width - self.width) / 2;
        y: Theme.top-bar-height + Theme.space-sm;
        width: min(root.width - 2 * Theme.space-lg, 960px);
        height: self.preferred-height;
    }
    if ExamsVM.new-open && RemarkVM.new-panel: RemarkNewPanel {
        x: (root.width - self.width) / 2;
        y: Theme.top-bar-height + Theme.space-sm;
        width: min(root.width - 2 * Theme.space-lg, 1120px);
        height: self.preferred-height;
        summary-h: min(400px, root.height - Theme.top-bar-height - 330px);
    }
}
