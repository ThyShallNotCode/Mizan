// Settings: theme, motion, the single-key shortcut switch (WCAG 2.1.4) and the review keymap.

import { Theme, Tone, Card, TopBar, StatusBar, StatusPill, Tag, Keycap, GirihDivider } from "../theme.slint";
import { App } from "../state.slint";
import {
    ThemeToggle, Centered, StatusText, Switch, Segment, SegmentGroup, SectionLabel, KVLine, MessageText,
} from "../widgets.slint";

component KeyLine inherits HorizontalLayout {
    in property <string> keys;
    in property <string> action;
    in property <string> note;
    in property <bool> narrow;
    spacing: Theme.space-md;
    height: 26px;
    Text {
        width: root.narrow ? 236px : 300px;
        text: root.action;
        font-size: Theme.text-sm;
        color: Theme.ink;
        vertical-alignment: center;
        overflow: elide;
    }
    HorizontalLayout {
        width: root.narrow ? 140px : 170px;
        alignment: start;
        Centered {
            Keycap {
                text: root.keys;
            }
        }
    }
    Text {
        text: root.note;
        font-family: Theme.font-arabic;
        font-size: Theme.text-xs;
        color: Theme.ink-2;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
    }
}

export component SettingsScreen inherits VerticalLayout {
    in property <length> win-w: 1440px;
    in property <length> win-h: 900px;
    property <bool> narrow: root.win-w < 1400px;
    TopBar {
        Text {
            text: "Settings";
            font-size: Theme.text-lg;
            font-weight: Theme.weight-semibold;
            color: Theme.ink;
            vertical-alignment: center;
        }
        Centered {
            ThemeToggle { }
        }
    }
    HorizontalLayout {
        vertical-stretch: 1;
        padding: Theme.space-xl;
        spacing: Theme.space-lg;
        VerticalLayout {
            width: root.narrow ? 420px : 460px;
            spacing: Theme.space-lg;
            Card {
                title: "Appearance";
                vertical-stretch: 0;
                subtitle: "Overlay colours on the scan never change with the theme (DESIGN §4)";
                HorizontalLayout {
                    spacing: Theme.space-md;
                    Text {
                        text: "Theme";
                        font-size: Theme.text-sm;
                        font-weight: Theme.weight-medium;
                        color: Theme.ink;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    SegmentGroup {
                        Segment {
                            text: "Light";
                            label: "Light theme setting";
                            selected: !Theme.dark;
                            clicked => {
                                Theme.dark = false;
                            }
                        }
                        Segment {
                            text: "Dark";
                            label: "Dark theme setting";
                            selected: Theme.dark;
                            clicked => {
                                Theme.dark = true;
                            }
                        }
                    }
                }
                Switch {
                    label: "Reduce motion";
                    description: "Every transition runs in 0 ms; also follows the OS preference";
                    checked: Theme.reduce-motion;
                    toggled(v) => {
                        Theme.reduce-motion = v;
                    }
                }
            }
            Card {
                title: "Review";
                vertical-stretch: 0;
                Switch {
                    label: "Single-key shortcuts";
                    description: "Option letters, digits, / and +/− act only while the review canvas has focus; turn off to use Ctrl chords and arrows only (WCAG 2.1.4)";
                    checked: App.single-key;
                    toggled(v) => {
                        App.set-single-key(v);
                    }
                }
                Switch {
                    label: "Show blank-bubble overlays";
                    description: "By default only filled, ambiguous and unreadable bubbles get overlays";
                    checked: App.show-all-default;
                    toggled(v) => {
                        App.show-all-default = v;
                    }
                }
            }
            Card {
                title: "About";
                vertical-stretch: 1;
                KVLine {
                    label: "Engine";
                    value: App.engine;
                    mono: true;
                }
                KVLine {
                    label: "Workspace";
                    value: App.workspace;
                    wrap-value: true;
                }
                Text {
                    text: "Demo data is synthetic: invented names, IDs starting with 9, and procedurally drawn scans. No real student data is used.";
                    font-size: Theme.text-xs;
                    color: Theme.ink-2;
                    wrap: word-wrap;
                }
                Rectangle {
                    vertical-stretch: 1;
                }
            }
        }
        Card {
            horizontal-stretch: 1;
            title: "Review keymap";
            subtitle: "Bound to physical key positions: under the Arabic (101) layout the A key still selects A; typed Arabic option letters in abjad order and Arabic-Indic digits work too (§13.3)";
            // the map's own rhythm: tighter below 880 px so all rows fit an 800 px window
            VerticalLayout {
                spacing: root.win-h < 880px ? 4px : 10px;
                KeyLine { narrow: root.narrow; action: "Set answer"; keys: "A–E · 1–5"; note: "A=أ or ش · B=ب or لا · C=ج or ؤ · D=د or ي · E=هـ or ث"; }
                KeyLine { narrow: root.narrow; action: "Accept suggestion / commit"; keys: "Enter"; note: "Commits the chosen value when one is chosen"; }
                KeyLine { narrow: root.narrow; action: "Apply to group"; keys: "Shift+Enter"; note: "Only when §13.2 batch-confirm conditions hold"; }
                KeyLine { narrow: root.narrow; action: "Next / previous"; keys: "↓ ↑ · J K"; note: "J and K only when no option uses them"; }
                KeyLine { narrow: root.narrow; action: "Blank"; keys: "Backspace"; note: ""; }
                KeyLine { narrow: root.narrow; action: "Multiple marks"; keys: "Ctrl+M"; note: "Invalid response"; }
                KeyLine { narrow: root.narrow; action: "Unreadable"; keys: "Ctrl+U"; note: "Rescan needed; never EMPTY"; }
                KeyLine { narrow: root.narrow; action: "Defer · Escalate · Rescan list"; keys: "Ctrl+D · E · R"; note: ""; }
                KeyLine { narrow: root.narrow; action: "Undo"; keys: "Ctrl+Z"; note: "Compensating event; the log is never rewritten"; }
                KeyLine { narrow: root.narrow; action: "Overlay · Original"; keys: "Space · F2"; note: ""; }
                KeyLine { narrow: root.narrow; action: "Roster search · Code help"; keys: "/ · F1"; note: ""; }
                KeyLine { narrow: root.narrow; action: "Identity: candidate · N · D"; keys: "1–3 · N · D"; note: "Not on roster · duplicate"; }
                KeyLine { narrow: root.narrow; action: "Screens"; keys: "Ctrl+1 … Ctrl+6"; note: "Exams … Outcomes; Ctrl+comma opens Settings"; }
                KeyLine { narrow: root.narrow; action: "Exams: search · new exam"; keys: "Ctrl+K · N"; note: "↑ ↓ move table rows, Enter opens the drawer"; }
                KeyLine { narrow: root.narrow; action: "Scan: pause · rescan list"; keys: "Ctrl+Space · R"; note: ""; }
                KeyLine { narrow: root.narrow; action: "Results: what-if preview"; keys: "Ctrl+P"; note: ""; }
            }
            Rectangle {
                vertical-stretch: 1;
            }
        }
    }
    StatusBar {
        MessageText {
            text: App.message;
            tone: App.message-tone;
            horizontal-stretch: 1;
        }
        StatusText {
            text: App.engine;
            mono: true;
        }
    }
}
