// Exam setup: template, answer key per version and the item × CLO mapping matrix with weight and
// note per cell (DESIGN §9.2, spec §6, §10.3, §11.2).

import {
    Theme, Tone, Severity, Card, TopBar, StatusBar, PrimaryButton, SecondaryButton, StatusPill, Tag,
    MeterBar, SeverityGlyph, FocusRing, Breadcrumb, TableRow, TableHeaderCell, GhostButton,
} from "../theme.slint";
import { App, SetupVM, MapRow, MapCell, KsRow, KsScan, RemarkVM } from "../state.slint";
import {
    RemarkFields, RemarkRefusal, RemarkImportCard, RemarkSideCard, RemarkApplyCard,
} from "remark.slint";
import {
    Icons, ThemeToggle, Centered, SectionLabel, StatusText, KVLine, EditCell, StepIndicator,
    EmptyState, MessageText, TextField, Segment, SegmentGroup,
} from "../widgets.slint";
import { ListView, ScrollView } from "std-widgets.slint";

// Key letter of one question in one version: click cycles A→B→…, typing a letter sets it.
component KeyCell inherits Rectangle {
    in property <string> letter;
    in property <string> label;
    callback cycle();
    callback set(string);
    width: 28px;
    height: 24px;
    border-radius: Theme.radius-sm;
    background: root.letter == "" ? transparent : ta.has-hover ? Theme.surface-hover : Theme.surface-raised;
    border-width: 1px;
    border-color: fs.has-focus ? Theme.primary : Theme.border-strong;
    accessible-role: AccessibleRole.text-input;
    accessible-label: root.label;
    accessible-value: root.letter;
    accessible-action-set-value(v) => {
        root.set(v);
    }
    accessible-action-default => {
        root.cycle();
    }
    ta := TouchArea {
        clicked => {
            fs.focus();
            root.cycle();
        }
    }
    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.cycle();
                return accept;
            }
            if (event.text == Key.Delete || event.text == Key.Backspace) {
                root.set("");
                return accept;
            }
            if (!event.modifiers.control && !event.modifiers.alt && event.text.character-count == 1 && event.text != Key.Tab) {
                root.set(event.text);
                return accept;
            }
            return reject;
        }
    }
    Text {
        text: root.letter == "" ? "·" : root.letter;
        font-family: Theme.font-mono;
        font-size: Theme.text-sm;
        font-weight: Theme.weight-semibold;
        color: root.letter == "" ? Theme.ink-3 : Theme.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
    FocusRing {
        active: fs.has-focus;
        corner: Theme.radius-sm;
    }
}

component MappingRow inherits Rectangle {
    in property <MapRow> data;
    in property <int> index;
    in property <length> clo-width;
    height: 34px;
    background: mod(root.index, 2) == 1 ? Theme.surface-sunken.with-alpha(0.45) : transparent;
    HorizontalLayout {
        Text {
            width: 56px;
            text: root.data.label;
            font-family: Theme.font-mono;
            font-size: Theme.text-sm;
            font-weight: Theme.weight-medium;
            color: Theme.ink;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        for k[v] in root.data.keys: HorizontalLayout {
            width: 52px;
            alignment: center;
            Centered {
                KeyCell {
                    letter: k;
                    label: root.data.label + " version " + SetupVM.versions[v] + " key";
                    cycle => {
                        SetupVM.cycle-key(root.index, v);
                    }
                    set(t) => {
                        SetupVM.set-key(root.index, v, t);
                    }
                }
            }
        }
        Text {
            width: 44px;
            text: root.data.points;
            font-family: Theme.font-mono;
            font-size: Theme.text-xs;
            color: Theme.ink-2;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Rectangle {
            width: 1px;
            background: Theme.border;
        }
        for c[ci] in root.data.cells: Rectangle {
            width: root.clo-width;
            EditCell {
                x: 6px;
                y: 4px;
                width: parent.width - 12px;
                text: c.text;
                label: c.label;
                placeholder: "–";
                highlighted: c.mapped;
                align: right;
                border-width: c.selected ? 1px : 0px;
                border-color: Theme.primary;
                committed(v) => {
                    SetupVM.set-weight(root.index, ci, v);
                }
                focused => {
                    SetupVM.select-cell(root.index, ci);
                }
            }
            // note indicator: a gold corner on cells that carry a note
            if c.has-note: Path {
                x: parent.width - 6px - 9px;
                y: 4px;
                width: 9px;
                height: 9px;
                viewbox-width: 9;
                viewbox-height: 9;
                commands: "M 0 0 L 9 0 L 9 9 Z";
                fill: Theme.accent;
                accessible-role: none;
            }
        }
        Rectangle {
            width: 1px;
            background: Theme.border;
        }
        Text {
            width: 56px;
            text: root.data.sum;
            font-family: Theme.font-mono;
            font-size: Theme.text-xs;
            font-weight: root.data.sum-ok ? Theme.weight-regular : Theme.weight-semibold;
            color: root.data.sum-ok ? Theme.ink-2 : Theme.error;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        HorizontalLayout {
            padding-left: Theme.space-sm;
            horizontal-stretch: 1;
            alignment: start;
            Centered {
                Tag {
                    text: root.data.status;
                    tone: root.data.status-tone;
                    mono: false;
                }
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}

component MatrixCard inherits Card {
    inset: 0;
    // set by the screen from the window width (never from the card's own width: no layout loop)
    in property <length> clo-width: 72px;
    in property <bool> narrow;
    VerticalLayout {
        // title, and the key's other sources: the instructor's filled answer sheets (§10.1)
        HorizontalLayout {
            padding: Theme.space-lg;
            padding-bottom: Theme.space-md;
            spacing: Theme.space-sm;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.space-2xs;
                alignment: start;
                Text {
                    text: "Answer key and CLO mapping";
                    font-size: Theme.text-lg;
                    font-weight: Theme.weight-semibold;
                    color: Theme.ink;
                    overflow: elide;
                }
                Text {
                    text: SetupVM.mapping-mode + " · digits type a weight, empty = no mapping · the gold corner marks a note";
                    font-size: Theme.text-xs;
                    color: Theme.ink-2;
                    wrap: word-wrap;
                }
            }
            if RemarkVM.context == 2 && (RemarkVM.has || RemarkVM.refused): VerticalLayout {
                alignment: start;
                SecondaryButton {
                    text: RemarkVM.refused ? "Remark import · refused" : "Remark import · review";
                    accessible-description: "Shows the Remark import read for this exam, waiting for your review";
                    clicked => {
                        SetupVM.key-open = false;
                        RemarkVM.setup-open = true;
                    }
                }
            }
            if SetupVM.has-keysheets: VerticalLayout {
                alignment: start;
                SecondaryButton {
                    text: SetupVM.ks-pending ? "Key sheets · confirm" : "Key sheets";
                    accessible-description: "Shows the key read from the key sheets";
                    clicked => {
                        SetupVM.key-open = false;
                        SetupVM.ks-open = true;
                    }
                }
            }
            VerticalLayout {
                alignment: start;
                SecondaryButton {
                    text: root.narrow ? "Read key sheet…" : "Read key from answer sheet…";
                    enabled: SetupVM.can-read-keysheets;
                    accessible-label: "Read key from answer sheet…";
                    accessible-description: "Reads the key from the instructor's filled answer sheets and shows it for your confirmation";
                    clicked => {
                        SetupVM.key-open = false;
                        SetupVM.ks-bar-open = !SetupVM.ks-bar-open;
                    }
                }
            }
        }
        // column-group header
        Rectangle {
            height: 24px;
            background: Theme.surface-sunken;
            HorizontalLayout {
                Rectangle {
                    width: 56px;
                }
                SectionLabel {
                    width: SetupVM.versions.length * 52px + 44px;
                    text: "KEY · VERSION";
                    horizontal-alignment: center;
                }
                Rectangle {
                    width: 1px;
                    background: Theme.border;
                }
                SectionLabel {
                    width: SetupVM.clos.length * root.clo-width;
                    text: "CLO MAPPING · WEIGHT w";
                    horizontal-alignment: center;
                }
                Rectangle {
                    width: 1px;
                    background: Theme.border;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
        }
        TableRow {
            header: true;
            TableHeaderCell {
                text: "Q";
                width: 56px;
                align: center;
            }
            for v in SetupVM.versions: TableHeaderCell {
                text: v;
                width: 52px;
                align: center;
            }
            TableHeaderCell {
                text: "Pts";
                width: 44px;
                align: center;
            }
            Rectangle {
                width: 1px;
                background: Theme.border;
            }
            for c in SetupVM.clos: Rectangle {
                width: root.clo-width;
                height: 32px;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: c.code;
                        font-family: Theme.font-mono;
                        font-size: Theme.text-xs;
                        font-weight: Theme.weight-medium;
                        color: Theme.ink;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: c.domain;
                        font-size: Theme.text-2xs;
                        color: Theme.ink-2;
                        horizontal-alignment: center;
                    }
                }
            }
            Rectangle {
                width: 1px;
                background: Theme.border;
            }
            TableHeaderCell {
                text: "Σw";
                width: 56px;
                align: center;
            }
            TableHeaderCell {
                text: "Status";
                horizontal-stretch: 1;
            }
        }
        ListView {
            vertical-stretch: 1;
            for r[i] in SetupVM.rows: MappingRow {
                data: r;
                index: i;
                clo-width: root.clo-width;
            }
        }
    }
}

component TemplateCard inherits Card {
    title: "Template";
    subtitle: SetupVM.template-kind;
    // a small share of the column's slack: Slint sizes wrapped lines (subtitle, page identity)
    // a line short here, and the checks card below takes the rest
    vertical-stretch: 0.2;
    VerticalLayout {
        spacing: Theme.space-sm;
        Rectangle {
            height: 30px;
            border-radius: Theme.radius-md;
            background: Theme.surface-sunken;
            HorizontalLayout {
                padding-left: Theme.space-md;
                padding-right: Theme.space-md;
                Text {
                    text: SetupVM.template-id;
                    font-family: Theme.font-mono;
                    font-size: Theme.text-sm;
                    font-weight: Theme.weight-medium;
                    color: Theme.primary;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        for kv in SetupVM.template: KVLine {
            label: kv.label;
            value: kv.value;
            wrap-value: true;
        }
        Rectangle {
            vertical-stretch: 1;
        }
    }
}

component LintCard inherits Card {
    title: "Checks";
    subtitle: SetupVM.lints.length + " findings before the key is published";
    vertical-stretch: 1;
    // scrolls when the findings outgrow the column (1280 × 800, DESIGN §9)
    // takes only the height left over (preferred small), so the template card above keeps its
    // content height
    ScrollView {
        vertical-stretch: 1;
        min-height: 48px;
        preferred-height: 48px;
        content-width: self.visible-width;
        VerticalLayout {
        spacing: Theme.space-md;
        alignment: start;
        for l in SetupVM.lints: HorizontalLayout {
            spacing: Theme.space-sm;
            VerticalLayout {
                padding-top: 3px;
                SeverityGlyph {
                    severity: l.severity;
                    size: 11px;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                HorizontalLayout {
                    alignment: start;
                    Tag {
                        text: l.code;
                        tone: l.severity == Severity.error ? Tone.error : Tone.warning;
                    }
                }
                Text {
                    text: l.message;
                    font-size: Theme.text-xs;
                    color: Theme.ink;
                    wrap: word-wrap;
                }
            }
        }
        }
    }
}

component CellCard inherits Card {
    title: SetupVM.sel-title;
    subtitle: SetupVM.sel-clo;
    vertical-stretch: 0;
    VerticalLayout {
        spacing: Theme.space-sm;
        SectionLabel {
            text: "WEIGHT";
        }
        EditCell {
            label: "Weight of " + SetupVM.sel-title;
            text: SetupVM.sel-weight;
            placeholder: "no mapping";
            align: left;
            height: 32px;
            border-width: 1px;
            border-color: Theme.border-strong;
            background: Theme.surface-raised;
            committed(v) => {
                SetupVM.set-weight(SetupVM.sel-row, SetupVM.sel-col, v);
            }
        }
        SectionLabel {
            text: "NOTE (ARABIC OR ENGLISH)";
        }
        EditCell {
            label: "Note of " + SetupVM.sel-title;
            text: SetupVM.sel-note;
            placeholder: "Why this item evidences the CLO";
            mono: false;
            arabic: true;
            align: left;
            height: 32px;
            border-width: 1px;
            border-color: Theme.border-strong;
            background: Theme.surface-raised;
            committed(v) => {
                SetupVM.set-note(SetupVM.sel-row, SetupVM.sel-col, v);
            }
        }
        if SetupVM.error != "": Text {
            text: SetupVM.error;
            font-size: Theme.text-xs;
            color: Theme.error;
            wrap: word-wrap;
        }
    }
}

component CloCard inherits Card {
    title: "Course learning outcomes";
    subtitle: SetupVM.clos.length == 0 ? "No CLOs in this exam: load a CLO file below" : "Share of the exam's evidence per CLO";
    vertical-stretch: 1;
    ScrollView {
        vertical-stretch: 1;
        min-height: 64px;
        preferred-height: 64px;
        content-width: self.visible-width;
        VerticalLayout {
        spacing: Theme.space-md;
        alignment: start;
        for c in SetupVM.clos: VerticalLayout {
            spacing: 2px;
            HorizontalLayout {
                spacing: Theme.space-sm;
                Text {
                    text: c.code;
                    font-family: Theme.font-mono;
                    font-size: Theme.text-xs;
                    font-weight: Theme.weight-semibold;
                    color: Theme.ink;
                    vertical-alignment: center;
                }
                Centered {
                    Tag {
                        text: c.domain;
                        tone: Tone.primary;
                    }
                }
                Text {
                    text: "PLO " + c.plo + " · " + c.items + " items";
                    font-size: Theme.text-2xs;
                    color: Theme.ink-2;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    horizontal-alignment: right;
                }
            }
            Text {
                text: c.title;
                font-size: Theme.text-xs;
                color: Theme.ink;
                overflow: elide;
            }
            Text {
                text: c.title-ar;
                font-family: Theme.font-arabic;
                font-size: Theme.text-xs;
                color: Theme.ink-2;
                horizontal-alignment: left;
                overflow: elide;
            }
            MeterBar {
                value: c.share;
                value-text: c.share-text;
                fill: Theme.series-1;
                thickness: 6px;
                height: 16px;
                accessible-label: c.code + " share of the evidence";
            }
        }
        }
    }
    // imported mappings (§11.2): approved here by an audited act, or replaced from a CLO file
    if SetupVM.mappings-proposed > 0: VerticalLayout {
        spacing: Theme.space-xs;
        Text {
            text: SetupVM.mappings-proposed + " imported mapping row(s) need review (imported, needs review): the TP-154 tables are a draft until you approve them";
            font-size: Theme.text-2xs;
            color: Theme.warning;
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
        }
        PrimaryButton {
            text: "Approve imported mappings";
            accessible-description: "Records you as the approver of every imported CLO mapping row (an audited approval); the TP-154 tables leave the draft watermark";
            clicked => {
                SetupVM.approve-mappings();
            }
        }
    }
    HorizontalLayout {
        spacing: Theme.space-sm;
        TextField {
            horizontal-stretch: 1;
            label: "CLO file";
            placeholder: "clo.csv: the CLOs and item mapping (replaces any in force)";
            text <=> SetupVM.clo-path;
            mono: true;
        }
        Centered {
            GhostButton {
                text: "Replace CLOs";
                enabled: SetupVM.clo-path != "";
                accessible-description: "Replaces this exam's CLOs and item to CLO mapping with the file (audited); the outcomes recompute, nothing is graded again";
                clicked => {
                    SetupVM.replace-clos(SetupVM.clo-path);
                }
            }
        }
    }
}

// Replace the whole key from a key file (the real key after an inferred one, a corrected file):
// a new key version, the exam rescored, every change audited (§10.1, §10.8).
component KeyBar inherits Rectangle {
    background: Theme.surface-raised;
    border-width: 1px;
    border-color: Theme.border-strong;
    init => {
        field.focus();
    }
    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                SetupVM.key-open = false;
                return accept;
            }
            return reject;
        }
        HorizontalLayout {
            padding-left: Theme.space-xl;
            padding-right: Theme.space-xl;
            padding-top: Theme.space-sm;
            padding-bottom: Theme.space-sm;
            spacing: Theme.space-md;
            Text {
                text: "Replace key";
                font-size: Theme.text-md;
                font-weight: Theme.weight-semibold;
                color: Theme.ink;
                vertical-alignment: center;
            }
            field := TextField {
                horizontal-stretch: 1;
                label: "Key file";
                placeholder: "Path of the key file, e.g. key.csv (question,A,B or form,Q1,Q2,…)";
                text <=> SetupVM.key-path;
                mono: true;
                accepted(v) => {
                    if (v != "") {
                        SetupVM.replace-key(v);
                    }
                }
            }
            Centered {
                PrimaryButton {
                    text: "Replace and rescore";
                    key-hint: "Enter";
                    enabled: SetupVM.key-path != "";
                    clicked => {
                        SetupVM.replace-key(SetupVM.key-path);
                    }
                }
            }
            Centered {
                GhostButton {
                    text: "Cancel";
                    clicked => {
                        SetupVM.key-open = false;
                    }
                }
            }
        }
    }
}


// Read the key from the instructor's filled answer sheets (§10.1): key-sheet files, read by the
// same recognizer as the students' sheets and shown for confirmation; nothing changes until then.
component KeySheetBar inherits Rectangle {
    background: Theme.surface-raised;
    border-width: 1px;
    border-color: Theme.border-strong;
    init => {
        field.focus();
    }
    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                SetupVM.ks-bar-open = false;
                return accept;
            }
            return reject;
        }
        HorizontalLayout {
            padding-left: Theme.space-xl;
            padding-right: Theme.space-xl;
            padding-top: Theme.space-sm;
            padding-bottom: Theme.space-sm;
            spacing: Theme.space-md;
            Text {
                text: "Key from answer sheets";
                font-size: Theme.text-md;
                font-weight: Theme.weight-semibold;
                color: Theme.ink;
                vertical-alignment: center;
            }
            field := TextField {
                horizontal-stretch: 1;
                label: "Key-sheet files";
                placeholder: "Scans or photos of the filled key sheets (student number all 0 or all 9, version bubbled); ; between several";
                text <=> SetupVM.ks-path;
                mono: true;
                accepted(v) => {
                    if (v != "") {
                        SetupVM.ks-read(v);
                    }
                }
            }
            Centered {
                PrimaryButton {
                    text: "Read key sheets";
                    key-hint: "Enter";
                    enabled: SetupVM.ks-path != "";
                    accessible-description: "Reads the key from the sheets and shows it for your confirmation; nothing changes until you confirm";
                    clicked => {
                        SetupVM.ks-read(SetupVM.ks-path);
                    }
                }
            }
            Centered {
                GhostButton {
                    text: "Cancel";
                    clicked => {
                        SetupVM.ks-bar-open = false;
                    }
                }
            }
        }
    }
}

// Import from Remark export (§3.5, PAR-09): Remark's graded Excel workbooks, read and shown for
// review; the key and its points per version replace the exam's only when applied.
component RemarkBar inherits Rectangle {
    background: Theme.surface-raised;
    border-width: 1px;
    border-color: Theme.border-strong;
    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                RemarkVM.setup-bar = false;
                return accept;
            }
            return reject;
        }
        HorizontalLayout {
            padding-left: Theme.space-xl;
            padding-right: Theme.space-xl;
            padding-top: Theme.space-sm;
            padding-bottom: Theme.space-sm;
            spacing: Theme.space-md;
            Text {
                text: "Import from Remark";
                font-size: Theme.text-md;
                font-weight: Theme.weight-semibold;
                color: Theme.ink;
                vertical-alignment: center;
            }
            RemarkFields {
                horizontal-stretch: 1;
            }
            Centered {
                GhostButton {
                    text: "Cancel";
                    clicked => {
                        RemarkVM.setup-bar = false;
                    }
                }
            }
        }
    }
}

// A small exclusive choice on a key-sheet row (an option letter, "Accept A|C", "Void").
component PickChip inherits Rectangle {
    in property <string> text;
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    height: 24px;
    width: max(28px, pick-text.preferred-width + 14px);
    border-radius: Theme.radius-sm;
    background: root.selected ? Theme.primary : ta.has-hover ? Theme.surface-hover : Theme.surface-raised;
    border-width: 1px;
    border-color: root.selected ? Theme.primary : Theme.border-strong;
    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => {
        root.clicked();
    }
    ta := TouchArea {
        clicked => {
            fs.focus();
            root.clicked();
        }
    }
    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    pick-text := Text {
        text: root.text;
        font-family: Theme.font-mono;
        font-size: Theme.text-xs;
        font-weight: Theme.weight-semibold;
        color: root.selected ? Theme.on-primary : Theme.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
    FocusRing {
        active: fs.has-focus;
        corner: Theme.radius-sm;
    }
}

// One question of the key read from key sheets: the bubble row as scanned (straightened, the
// marks outlined in the paper colours), what it reads, what it gives the key, and, on a row that
// waits for the instructor, the choices.
component KeySheetRowView inherits Rectangle {
    in property <KsRow> data;
    in property <image> crop;
    in property <int> index;
    in property <length> crop-w;
    in property <length> read-w;
    height: 58px;
    background: root.data.highlight ? (root.data.open ? Theme.warning-soft : Theme.accent-soft) : mod(root.index, 2) == 1 ? Theme.surface-sunken.with-alpha(0.45) : transparent;
    accessible-role: AccessibleRole.list-item;
    accessible-label: root.data.label;
    // the highlight is also a shape: a bar on the inline-start edge (never colour alone)
    if root.data.highlight: Rectangle {
        x: 0;
        width: 3px;
        height: parent.height;
        background: root.data.open ? Theme.warning : Theme.accent;
    }
    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        spacing: Theme.space-md;
        Text {
            width: 40px;
            text: root.data.q;
            font-family: Theme.font-mono;
            font-size: Theme.text-sm;
            font-weight: Theme.weight-semibold;
            color: Theme.ink;
            vertical-alignment: center;
            accessible-role: none;
        }
        Centered {
            Rectangle {
                width: root.crop-w;
                height: 46px;
                border-radius: Theme.radius-sm;
                background: Theme.scan-backdrop;
                clip: true;
                if root.data.has-crop: Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.crop;
                    image-fit: contain;
                    accessible-role: none;
                }
                if !root.data.has-crop: Text {
                    text: "no image";
                    font-size: Theme.text-2xs;
                    color: Theme.ink-3;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
        }
        Text {
            width: root.read-w;
            text: root.data.read;
            font-family: Theme.font-mono;
            font-size: Theme.text-md;
            font-weight: Theme.weight-semibold;
            color: root.data.open ? Theme.warning : Theme.ink;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            alignment: center;
            spacing: 3px;
            if root.data.open: HorizontalLayout {
                spacing: 4px;
                alignment: start;
                for o[oi] in SetupVM.ks-option-labels: PickChip {
                    text: o;
                    label: root.data.q + " version " + SetupVM.ks-version-letter + " answer " + o;
                    selected: root.data.pick == o;
                    clicked => {
                        SetupVM.ks-choose(root.index, oi);
                    }
                }
                if root.data.marked != "": PickChip {
                    text: "Accept " + root.data.marked;
                    label: root.data.q + " version " + SetupVM.ks-version-letter + " accept " + root.data.marked;
                    selected: root.data.pick == root.data.marked;
                    clicked => {
                        SetupVM.ks-choose(root.index, -2);
                    }
                }
                PickChip {
                    text: "Void";
                    label: root.data.q + " version " + SetupVM.ks-version-letter + " void";
                    selected: root.data.pick == "*";
                    clicked => {
                        SetupVM.ks-choose(root.index, -1);
                    }
                }
            }
            if !root.data.open: HorizontalLayout {
                spacing: Theme.space-sm;
                alignment: start;
                Text {
                    text: "Key " + root.data.answer;
                    font-family: Theme.font-mono;
                    font-size: Theme.text-sm;
                    font-weight: Theme.weight-semibold;
                    color: Theme.primary;
                    vertical-alignment: center;
                    accessible-role: none;
                }
                if root.data.key-now != "": Centered {
                    Tag {
                        text: root.data.key-now;
                        tone: Tone.accent;
                    }
                }
            }
            if root.data.detail != "": Text {
                text: root.data.detail;
                font-size: Theme.text-2xs;
                color: Theme.ink-2;
                overflow: elide;
                accessible-role: none;
            }
        }
        Centered {
            width: 140px;
            HorizontalLayout {
                alignment: start;
                StatusPill {
                    text: root.data.status;
                    tone: root.data.status-tone;
                    max-pill-width: 140px;
                    accessible-role: none;
                }
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}

// The key-sheet scans of the version shown (and those that give no key, with why).
component KeySheetScansCard inherits Card {
    title: "Key sheets";
    subtitle: SetupVM.ks-source;
    vertical-stretch: 1;
    ScrollView {
        vertical-stretch: 1;
        min-height: 64px;
        preferred-height: 64px;
        content-width: self.visible-width;
        VerticalLayout {
            spacing: Theme.space-md;
            alignment: start;
            for k in SetupVM.ks-scans: VerticalLayout {
                spacing: 2px;
                Text {
                    text: k.label;
                    font-family: Theme.font-mono;
                    font-size: Theme.text-xs;
                    font-weight: Theme.weight-semibold;
                    color: Theme.ink;
                    wrap: word-wrap;
                }
                Text {
                    text: k.origin + (k.version != "" ? " · version " + k.version : "") + (k.id-read != "" ? " · ID grid " + k.id-read : "");
                    font-size: Theme.text-2xs;
                    color: Theme.ink-2;
                    wrap: word-wrap;
                }
                if k.registration != "": Text {
                    text: k.registration;
                    font-family: Theme.font-mono;
                    font-size: Theme.text-2xs;
                    color: Theme.ink-3;
                    wrap: word-wrap;
                }
                if k.refusal != "": HorizontalLayout {
                    spacing: Theme.space-xs;
                    VerticalLayout {
                        padding-top: 2px;
                        SeverityGlyph {
                            severity: Severity.error;
                            size: 10px;
                        }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: k.refusal;
                        font-size: Theme.text-2xs;
                        color: Theme.error;
                        wrap: word-wrap;
                    }
                }
            }
            for n in SetupVM.ks-notes: Text {
                text: n;
                font-size: Theme.text-2xs;
                color: Theme.ink-2;
                wrap: word-wrap;
            }
        }
    }
}

// The confirmation (§10.1: the instructor MUST confirm the rendered key; never auto-accepted).
component KeySheetConfirmCard inherits Card {
    title: SetupVM.ks-confirmed ? "Confirmed" : "Confirm the key";
    subtitle: SetupVM.ks-version-status;
    vertical-stretch: 0;
    VerticalLayout {
        spacing: Theme.space-sm;
        PrimaryButton {
            text: SetupVM.ks-confirm-label;
            enabled: SetupVM.ks-can-confirm;
            accessible-description: SetupVM.ks-can-confirm ? SetupVM.ks-consequence : SetupVM.ks-version-status;
            clicked => {
                SetupVM.ks-confirm(false);
            }
        }
        if SetupVM.ks-versions.length > 1: SecondaryButton {
            text: "Confirm every version";
            enabled: SetupVM.ks-can-confirm-all;
            accessible-description: SetupVM.ks-consequence;
            clicked => {
                SetupVM.ks-confirm(true);
            }
        }
        Text {
            text: SetupVM.ks-consequence;
            font-size: Theme.text-2xs;
            color: Theme.ink-2;
            wrap: word-wrap;
        }
        if SetupVM.ks-preview: GhostButton {
            text: "Put aside";
            accessible-description: "Drops the key read from these files; the exam's key is unchanged";
            clicked => {
                SetupVM.ks-discard();
            }
        }
        GhostButton {
            text: "Key and CLO mapping";
            accessible-description: "Back to the answer key and CLO mapping matrix";
            clicked => {
                SetupVM.ks-open = false;
            }
        }
    }
}

// The key read from key sheets, version by version.
component KeySheetCard inherits Card {
    in property <bool> narrow;
    inset: 0;
    property <length> crop-w: root.narrow ? 196px : 236px;
    VerticalLayout {
        HorizontalLayout {
            padding: Theme.space-lg;
            padding-bottom: Theme.space-md;
            spacing: Theme.space-md;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.space-2xs;
                alignment: start;
                Text {
                    text: "Key from answer sheets · " + SetupVM.ks-version-title;
                    font-size: Theme.text-lg;
                    font-weight: Theme.weight-semibold;
                    color: Theme.ink;
                    overflow: elide;
                }
                Text {
                    text: "Each row as scanned beside what it gives the key; highlighted rows need your decision (never accepted on their own)";
                    font-size: Theme.text-xs;
                    color: Theme.ink-2;
                    wrap: word-wrap;
                }
            }
            if SetupVM.ks-versions.length > 0: VerticalLayout {
                alignment: start;
                SegmentGroup {
                    for v[i] in SetupVM.ks-versions: Segment {
                        text: v.label;
                        label: v.a11y;
                        selected: v.selected;
                        clicked => {
                            SetupVM.ks-select-version(i);
                        }
                    }
                }
            }
        }
        TableRow {
            header: true;
            TableHeaderCell {
                text: "Q";
                width: 40px + Theme.space-md;
            }
            TableHeaderCell {
                text: "Sheet as scanned";
                width: root.crop-w + Theme.space-md;
            }
            TableHeaderCell {
                text: "Reads";
                width: 56px + Theme.space-md;
                align: center;
            }
            TableHeaderCell {
                text: "Key entry";
                horizontal-stretch: 1;
            }
            TableHeaderCell {
                text: "Status";
                width: 140px + Theme.space-md;
            }
        }
        ListView {
            vertical-stretch: 1;
            for r[i] in SetupVM.ks-rows: KeySheetRowView {
                data: r;
                crop: SetupVM.ks-crops[i];
                index: i;
                crop-w: root.crop-w;
                read-w: 56px;
            }
        }
    }
}

export component SetupScreen inherits VerticalLayout {
    in property <length> win-w: 1440px;
    in property <length> win-h: 900px;
    property <bool> narrow: root.win-w < 1400px;
    // a long key tag ("Key v1 · from key sheets · NOT CONFIRMED") leaves no room for the step
    // names beside the top bar's buttons: the stepper then shows numbers only
    property <bool> compact-bar: root.narrow || SetupVM.key-status.character-count > 24;
    property <length> left-w: root.narrow ? 248px : 284px;
    property <length> right-w: root.narrow ? 264px : 296px;
    // matrix width = window − rail − padding − gutters − side columns; CLO cells share what the
    // fixed columns (Q, keys, points, Σw, status) leave, between 44 and 72 px
    property <length> matrix-w: root.win-w - Theme.nav-rail-width - 2 * Theme.space-xl - 2 * Theme.space-lg - root.left-w - root.right-w;
    property <length> clo-w: clamp((root.matrix-w - 56px - SetupVM.versions.length * 52px - 44px - 2px - 56px - 84px) / max(1, SetupVM.clos.length), 44px, 72px);
    TopBar {
        Breadcrumb {
            parts: [App.course, App.assessment, "Setup"];
        }
        HorizontalLayout {
            spacing: Theme.space-lg;
            StepIndicator {
                number: 1;
                text: "Template";
                compact: root.compact-bar;
                state: 1;
            }
            StepIndicator {
                number: 2;
                text: "Forms and key";
                compact: root.compact-bar;
                state: SetupVM.key-published ? 1 : 2;
            }
            StepIndicator {
                number: 3;
                text: "CLO mapping";
                compact: root.compact-bar;
                state: SetupVM.lints.length > 0 || SetupVM.clos.length == 0 ? 2 : 1;
            }
            // without a roster no identity is matched: shown as a warning, never as done
            StepIndicator {
                number: 4;
                text: "Roster";
                compact: root.compact-bar;
                state: SetupVM.has-roster ? 1 : 2;
            }
            StepIndicator {
                number: 5;
                text: "Policies";
                compact: root.compact-bar;
                state: 1;
            }
        }
        HorizontalLayout {
            spacing: Theme.space-sm;
            Centered {
                Tag {
                    text: SetupVM.key-status;
                    tone: SetupVM.key-published ? Tone.success : Tone.accent;
                }
            }
            Centered {
                SecondaryButton {
                    text: root.compact-bar ? "Remark…" : "Import from Remark…";
                    enabled: RemarkVM.can-setup;
                    accessible-label: "Import from Remark export…";
                    accessible-description: "Reads Remark's graded Excel exports: the key with exact points per version and the learning objectives, shown for your review before anything changes";
                    clicked => {
                        SetupVM.key-open = false;
                        SetupVM.ks-bar-open = false;
                        RemarkVM.setup-bar = !RemarkVM.setup-bar;
                    }
                }
            }
            Centered {
                PrimaryButton {
                    text: "Replace key…";
                    enabled: SetupVM.can-replace-key;
                    accessible-description: "Replaces the whole answer key from a key file: a new key version, rescored and audited";
                    clicked => {
                        SetupVM.ks-bar-open = false;
                        RemarkVM.setup-bar = false;
                        SetupVM.key-open = !SetupVM.key-open;
                    }
                }
            }
            Centered {
                ThemeToggle { }
            }
        }
    }
    if SetupVM.available && SetupVM.key-open: KeyBar { }
    if SetupVM.available && SetupVM.ks-bar-open: KeySheetBar { }
    if SetupVM.available && RemarkVM.setup-bar: RemarkBar { }
    if !SetupVM.available: EmptyState {
        vertical-stretch: 1;
        title: "No setup for this exam yet";
        text: "Choose a template to start.";
    }
    // the Remark import read here, for review (it replaces the matrix until applied or put aside)
    if SetupVM.available && RemarkVM.setup-open && RemarkVM.context == 2: HorizontalLayout {
        vertical-stretch: 1;
        padding: Theme.space-xl;
        spacing: Theme.space-lg;
        if RemarkVM.refused: VerticalLayout {
            horizontal-stretch: 1;
            spacing: Theme.space-lg;
            RemarkRefusal {
                message: RemarkVM.refusal;
                remedy: RemarkVM.remedy;
                suggestion: RemarkVM.suggestion;
                use-suggested => {
                    RemarkVM.use-suggested();
                }
            }
            HorizontalLayout {
                alignment: start;
                GhostButton {
                    text: "Key and CLO mapping";
                    accessible-description: "Back to the answer key and CLO mapping matrix";
                    clicked => {
                        RemarkVM.setup-open = false;
                    }
                }
            }
            Rectangle {
                vertical-stretch: 1;
            }
        }
        if !RemarkVM.refused: RemarkImportCard {
            horizontal-stretch: 1;
        }
        if !RemarkVM.refused: VerticalLayout {
            width: root.narrow ? 340px : 380px;
            spacing: Theme.space-lg;
            RemarkApplyCard {
                show-back: true;
                back => {
                    RemarkVM.setup-open = false;
                }
            }
            RemarkSideCard {
                vertical-stretch: 1;
            }
        }
    }
    if SetupVM.available && !(RemarkVM.setup-open && RemarkVM.context == 2) && SetupVM.has-keysheets && SetupVM.ks-open: HorizontalLayout {
        vertical-stretch: 1;
        padding: Theme.space-xl;
        spacing: Theme.space-lg;
        KeySheetCard {
            horizontal-stretch: 1;
            narrow: root.narrow;
        }
        VerticalLayout {
            width: root.right-w;
            spacing: Theme.space-lg;
            KeySheetConfirmCard { }
            KeySheetScansCard { }
        }
    }
    if SetupVM.available && !(RemarkVM.setup-open && RemarkVM.context == 2) && !(SetupVM.has-keysheets && SetupVM.ks-open): HorizontalLayout {
        vertical-stretch: 1;
        padding: Theme.space-xl;
        spacing: Theme.space-lg;
        VerticalLayout {
            width: root.left-w;
            spacing: Theme.space-lg;
            TemplateCard { }
            LintCard { }
        }
        MatrixCard {
            horizontal-stretch: 1;
            clo-width: root.clo-w;
            narrow: root.narrow;
        }
        VerticalLayout {
            width: root.right-w;
            spacing: Theme.space-lg;
            // without CLOs there is no cell to edit
            if SetupVM.clos.length > 0: CellCard { }
            CloCard { }
        }
    }
    StatusBar {
        Centered {
            StatusPill {
                text: "Saved";
                tone: Tone.success;
            }
        }
        MessageText {
            text: App.message;
            tone: App.message-tone;
            horizontal-stretch: 1;
        }
        StatusText {
            text: "Key and mapping edits are recorded as audited events (§14.4)";
        }
        StatusText {
            text: App.engine;
            mono: true;
        }
    }
}
